    function selectTicket(ticketCode) {
      if (ticketCode === 'TKT-2024-0102') {
        alert('Phiếu bảo hành [TKT-2024-0102] của Bàn phím cơ Leopold FC900R đã hoàn tất và bàn giao vào ngày 24/04/2024!');
      } else {
        alert('Đang xem chi tiết tiến độ phiếu bảo hành #' + ticketCode);
      }
    }

    function filterTickets(query) {
      const q = query.toLowerCase().trim();
      const items = document.querySelectorAll('.ticket-card-item');
      items.forEach(item => {
        const text = item.innerText.toLowerCase();
        if (text.includes(q)) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    }

    function sendChatMessage(e) {
      e.preventDefault();
      const input = document.getElementById('chatInputMessage');
      const text = input.value.trim();
      if (!text) return;

      const feed = document.getElementById('chatMessagesFeed');
      const now = new Date();
      const timeStr = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');

      const msgHtml = `
        <div class="flex items-start justify-end gap-3 animate-fadeIn">
          <div class="max-w-[85%] sm:max-w-[75%] text-right">
            <span class="text-[11px] font-bold text-slate-700 block mb-1">Bạn • <span class="font-normal text-slate-400">${timeStr}</span></span>
            <div class="p-3.5 bg-[#ff6b00] text-white rounded-2xl rounded-tr-none text-xs leading-relaxed shadow-xs inline-block text-left font-medium">
              ${text.replace(/</g, '&lt;').replace(/>/g, '&gt;')}
            </div>
          </div>
          <div class="w-8 h-8 rounded-full bg-[#111315] text-white font-bold text-[11px] flex items-center justify-center shrink-0">
            KH
          </div>
        </div>
      `;

      feed.insertAdjacentHTML('beforeend', msgHtml);
      input.value = '';
      feed.scrollTop = feed.scrollHeight;

      // Giả lập KTV tự động phản hồi sau 1.5 giây
      setTimeout(() => {
        const replyHtml = `
          <div class="flex items-start gap-3 animate-fadeIn">
            <div class="w-8 h-8 rounded-full overflow-hidden shrink-0 border border-slate-200">
              <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80"
                alt="KTV Lê Minh Trí" class="w-full h-full object-cover">
            </div>
            <div class="max-w-[85%] sm:max-w-[75%]">
              <span class="text-[11px] font-bold text-slate-700 block mb-1">KTV Lê Minh Trí • <span class="font-normal text-slate-400">${timeStr}</span></span>
              <div class="p-3.5 bg-white border border-slate-200/90 rounded-2xl rounded-tl-none text-xs text-slate-800 leading-relaxed shadow-xs">
                Em đã nhận được tin nhắn từ anh/chị. Em sẽ kiểm tra và phản hồi lại ngay ạ!
              </div>
            </div>
          </div>
        `;
        feed.insertAdjacentHTML('beforeend', replyHtml);
        feed.scrollTop = feed.scrollHeight;
      }, 1500);
    }

    function confirmReceipt() {
      if (confirm('Bạn có chắc chắn đã nhận lại máy và kiểm tra đầy đủ mọi chức năng hoạt động hoàn hảo không?')) {
        alert('Cảm ơn quý khách! Hồ sơ #TKT-2024-0419 đã được ghi nhận hoàn tất nghiệm thu và chuyển sang trạng thái đã giao trả thành công.');
      }
    }

    function openLoginModal() {
      window.location.href = '/dang-nhap';
    }

    function closeLoginModal() {
      document.getElementById('loginModal').classList.add('hidden');
      document.getElementById('loginModal').classList.remove('flex');
    }
  </script>

</body>

</html>

