          <label class="block font-bold text-slate-700 mb-1">Mô tả triệu chứng / Hiện tượng lỗi *</label>
          <textarea rows="3" required placeholder="Ví dụ: Màn hình sọc ngang, chớp tắt khi cắm sạc nguồn..."
            class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#ff6b00]/30 focus:border-[#ff6b00]"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Mức độ ưu tiên SLA</label>
            <select class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl">
              <option value="SLA-24H">Khẩn cấp - SLA 24 Giờ</option>
              <option value="SLA-48H" selected>Tiêu chuẩn - SLA 48 Giờ</option>
              <option value="SLA-72H">Bình thường - SLA 72 Giờ</option>
            </select>
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Kỹ thuật viên phụ trách</label>
            <select class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl">
              <option value="KTV-08">Lê Minh Trí (KTV-08)</option>
              <option value="KTV-02">Trần Bảo Nam (KTV-02)</option>
              <option value="KTV-05">Nguyễn Quốc Huy (KTV-05)</option>
            </select>
          </div>
        </div>

        <div class="pt-3 border-t border-slate-100 flex justify-end gap-2">
          <button type="button" onclick="closeModal('createTicketModal')" class="px-4 py-2 font-bold text-slate-500 hover:text-slate-800">
            Hủy
          </button>
          <button type="submit" class="px-5 py-2 bg-[#ff6b00] hover:bg-[#e05800] text-white font-bold rounded-xl shadow-xs active:scale-95 transition-all">
            Tạo phiếu tiếp nhận
          </button>
        </div>
      </form>

    </div>
  </div>

  <!-- ==============================================
       JAVASCRIPT: QUẢN LÝ TƯƠNG TÁC BẢNG & MODAL
  ============================================== -->
  <script>
    // 1. Toggle Sidebar Drawer trên mobile
    function toggleSidebar() {
      const sidebar = document.getElementById('adminSidebar');
      const overlay = document.getElementById('sidebarOverlay');
      if (sidebar && overlay) {
        sidebar.classList.toggle('-translate-x-full');
        overlay.classList.toggle('hidden');
      }
    }

    // 2. Mở / Đóng Modal dùng chung
    function openModal(modalId) {
      const modal = document.getElementById(modalId);
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
    }

    function closeModal(modalId) {
      const modal = document.getElementById(modalId);
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    function openAddCustomerModal() {
      openModal('addCustomerModal');
    }

    function openFilterModal() {
      openModal('filterModal');
    }

    // 3. Tìm kiếm và Lọc theo phân loại (Combobox & Input)
    function filterCustomerTable() {
      const search = (document.getElementById('searchInput')?.value || '').toLowerCase().trim();
      const category = document.getElementById('categorySelect')?.value || 'all';
      const rows = document.querySelectorAll('#customerTable tbody tr.customer-row');

      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        const rowCategory = row.getAttribute('data-category');
        const matchSearch = !search || text.includes(search);
        const matchCategory = category === 'all' || rowCategory === category;

        if (matchSearch && matchCategory) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    // 5. Chọn tất cả checkbox
    function toggleSelectAll(master) {
      const checkboxes = document.querySelectorAll('.row-checkbox');
      checkboxes.forEach(cb => cb.checked = master.checked);
    }

    // 6. Xem chi tiết khách hàng
    function viewCustomerDetail(name, phone, email, address, type, devices, warranties, cccd) {
      const body = document.getElementById('detailCustomerBody');
      body.innerHTML = `
        <div class="flex items-center gap-3.5 p-3.5 bg-slate-50 rounded-2xl border border-slate-100">
          <div class="w-12 h-12 rounded-full bg-[#ff6b00]/15 text-[#ff6b00] font-black text-sm flex items-center justify-center border border-[#ff6b00]/30">
            ${name.split(' ').map(n=>n[0]).slice(-2).join('')}
          </div>
          <div>
            <h4 class="font-extrabold text-slate-900 text-sm">${name}</h4>
            <div class="text-slate-500 text-[11px] mt-0.5">${phone} • ${email}</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 pt-1">
          <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
            <span class="text-slate-400 block text-[10px] uppercase font-bold">Phân loại</span>
            <span class="font-bold text-slate-800 text-xs mt-0.5 block">${type}</span>
          </div>
          <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
            <span class="text-slate-400 block text-[10px] uppercase font-bold">Giấy tờ tùy thân / MST</span>
            <span class="font-mono font-bold text-slate-800 text-xs mt-0.5 block">${cccd}</span>
          </div>
        </div>

        <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
          <span class="text-slate-400 block text-[10px] uppercase font-bold">Địa chỉ lưu trú</span>
          <span class="font-semibold text-slate-800 text-xs mt-0.5 block">${address}</span>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-3 bg-orange-50/70 border border-orange-100 rounded-xl text-center">
            <span class="text-[#c2410c] text-xl font-black block">${devices}</span>
            <span class="text-[#ea580c] text-[10.5px] font-bold">Thiết bị đang sở hữu</span>
          </div>
          <div class="p-3 bg-blue-50/70 border border-blue-100 rounded-xl text-center">
            <span class="text-[#1d4ed8] text-xl font-black block">${warranties}</span>
            <span class="text-[#2563eb] text-[10.5px] font-bold">Lần gửi bảo hành</span>
          </div>
        </div>

        <div class="pt-2">
          <span class="font-bold text-slate-800 block mb-1.5 text-[11px]">Danh sách thiết bị liên kết:</span>
          <div class="space-y-1.5 text-[11px]">
            <div class="p-2 rounded-lg bg-white border border-slate-200 flex items-center justify-between">
              <span class="font-semibold text-slate-800">Dell XPS 15 9530 (Core i7 / OLED)</span>
              <span class="text-emerald-600 font-bold text-[10px] bg-emerald-50 px-2 py-0.5 rounded">Còn hạn BH</span>
            </div>
            <div class="p-2 rounded-lg bg-white border border-slate-200 flex items-center justify-between">
              <span class="font-semibold text-slate-800">iPhone 15 Pro Max 256GB</span>
              <span class="text-emerald-600 font-bold text-[10px] bg-emerald-50 px-2 py-0.5 rounded">Còn hạn BH</span>
            </div>
          </div>
        </div>
      `;
      openModal('viewCustomerModal');
    }

    // 7. Chỉnh sửa khách hàng
    function editCustomer(name, phone) {
      alert(`Đang mở giao diện chỉnh sửa thông tin cho khách hàng: ${name} (${phone})`);
    }

    // 8. Tạo phiếu BH nhanh
    function openCreateTicketModal(name, phone) {
      document.getElementById('ticketCustName').value = `${name} - ${phone}`;
      document.getElementById('ticketCustomerSub').innerText = `Tạo phiếu tiếp nhận bảo hành cho: ${name}`;
      openModal('createTicketModal');
    }

    function handleQuickTicket(e) {
      e.preventDefault();
      alert('Tạo phiếu yêu cầu bảo hành thành công! Phiếu đã được chuyển sang trạng thái "Đang xử lý & Chờ duyệt linh kiện".');
      closeModal('createTicketModal');
    }

    // 9. Lưu khách hàng mới
    function handleSaveCustomer(e) {
      e.preventDefault();
      const name = document.getElementById('custName').value.trim();
      const phone = document.getElementById('custPhone').value.trim();
      const email = document.getElementById('custEmail').value.trim() || 'chuaco@email.com';
      const type = document.getElementById('custType').value;
      const city = document.getElementById('custCity').value.trim() || 'Hà Nội';
      const address = document.getElementById('custAddress').value.trim() || 'Chưa cập nhật';
      const cccd = document.getElementById('custIdNumber').value.trim() || '001094******';

      const tbody = document.querySelector('#customerTable tbody');
      const newTr = document.createElement('tr');
      newTr.className = 'hover:bg-slate-50/80 transition-colors customer-row bg-emerald-50/20';
      newTr.setAttribute('data-category', type);

      let typeBadge = '';
      if (type === 'vip') {
        typeBadge = '<span class="inline-flex items-center gap-1 bg-[#fff8eb] text-[#b45309] border border-[#fde68a] text-[10px] font-bold px-2 py-0.5 rounded-md">★ VIP • Doanh nghiệp</span>';
      } else if (type === 'daily') {
        typeBadge = '<span class="inline-flex items-center bg-[#fef2f2] text-[#b91c1c] border border-[#fecaca] text-[10px] font-bold px-2 py-0.5 rounded-md">Đại lý ủy quyền</span>';
      } else {
        typeBadge = '<span class="inline-flex items-center bg-slate-100 text-slate-600 text-[10px] font-bold px-2 py-0.5 rounded-md">Cá nhân</span>';
      }

      const initials = name.split(' ').map(n=>n[0]).slice(-2).join('').toUpperCase();
      const randomId = Math.floor(1000 + Math.random() * 9000);

      newTr.innerHTML = `
        <td class="py-4 pl-4 sm:pl-6 pr-2 text-center">
          <input type="checkbox" class="row-checkbox rounded border-slate-300 text-[#ff6b00] focus:ring-[#ff6b00]/30 cursor-pointer">
        </td>
        <td class="py-4 px-3 font-mono font-bold text-slate-400 text-[11px]">
          ${randomId}
        </td>
        <!-- Cột 1: KHÁCH HÀNG -->
        <td class="py-4 px-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-800 font-black text-xs flex items-center justify-center flex-shrink-0 border border-emerald-200">
              ${initials}
            </div>
            <div>
              <div class="font-bold text-slate-900 text-sm tracking-tight customer-name">
                ${name}
              </div>
              <div class="text-[10.5px] text-slate-400 font-mono mt-0.5">
                ${cccd}
              </div>
            </div>
          </div>
        </td>
        <!-- Cột 2: PHÂN LOẠI -->
        <td class="py-4 px-4">
          ${typeBadge}
        </td>
        <!-- THIẾT BỊ SỞ HỮU -->
        <td class="py-4 px-4 text-center text-slate-700 font-medium text-xs">
          <span class="font-bold text-slate-900 text-sm">1</span> thiết bị
        </td>
        <!-- SỐ LẦN BẢO HÀNH -->
        <td class="py-4 px-4 text-center text-slate-700 font-medium text-xs">
          <span class="font-bold text-slate-900 text-sm">0</span> lần
        </td>
        <!-- NGÀY THAM GIA -->
        <td class="py-4 px-4 text-center text-slate-500 font-medium text-[11px]">
          Hôm nay
        </td>
        <!-- THAO TÁC -->
        <td class="py-4 pl-4 pr-6 text-center">
          <div class="flex items-center justify-center gap-2">
            <button type="button" onclick="viewCustomerDetail('${name}', '${phone}', '${email}', '${city} - ${address}', '${type}', 1, 0, '${cccd}')"
              class="text-slate-400 hover:text-slate-700 p-1 rounded-md transition-colors cursor-pointer" title="Xem chi tiết">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
            <button type="button" onclick="editCustomer('${name}', '${phone}')"
              class="text-slate-400 hover:text-slate-700 p-1 rounded-md transition-colors cursor-pointer" title="Chỉnh sửa">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
              </svg>
            </button>
            <button type="button" onclick="openCreateTicketModal('${name}', '${phone}')"
              class="bg-[#fff3eb] hover:bg-[#ffe5d3] text-[#c2410c] border border-[#fed7aa] px-2.5 py-1.5 rounded-xl font-bold text-[11px] flex flex-col items-center leading-tight transition-all active:scale-95 cursor-pointer shadow-2xs">
              <span>Tạo</span>
              <span class="flex items-center gap-0.5 font-black text-[10px]">⊕ phiếu BH</span>
            </button>
          </div>
        </td>
      `;

      tbody.insertBefore(newTr, tbody.firstChild);
      closeModal('addCustomerModal');
      document.getElementById('addCustomerForm').reset();
      alert(`Đã thêm thành công khách hàng: ${name} vào cơ sở dữ liệu!`);
    }

    // 10. Xuất / Nhập Excel
    function triggerImportExcel() {
      alert('Đang mở hộp thoại chọn tệp Excel (.xlsx, .csv) chứa danh sách khách hàng để nhập dữ liệu...');
    }

    // 11. Áp dụng bộ lọc nâng cao
    function applyAdvancedFilter() {
      const city = document.getElementById('filterCity').value.toLowerCase().trim();
      const minDevices = parseInt(document.getElementById('filterDevices').value) || 0;
      const rows = document.querySelectorAll('#customerTable tbody tr.customer-row');

      rows.forEach(row => {
        const onclickAttr = row.querySelector('button[onclick*="viewCustomerDetail"]')?.getAttribute('onclick') || '';
        const matchCity = !city || onclickAttr.toLowerCase().includes(city);
        if (matchCity) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });

      closeModal('filterModal');
    }

    function resetAdvancedFilter() {
      document.getElementById('filterCity').value = '';
      document.getElementById('filterDevices').value = '0';
      document.getElementById('filterWarranties').value = 'all';
      filterCustomerTable();
      closeModal('filterModal');
    }
  </script>

</body>

</html>

