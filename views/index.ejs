<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WarrantyOps — Quản lý Hồ sơ & Phiếu Bảo hành</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">

  <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#fff7ed',
              100: '#ffedd5',
              500: '#f97316',
              600: '#ea580c',
              700: '#c2410c'
            }
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'system-ui', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          }
        }
      }
    };
  </script>

  <style>
    body {
      background-color: #f8fafc;
      color: #0f172a;
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    }
    .site-header .container,
    .site-footer .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }
    .tabular-nums {
      font-variant-numeric: tabular-nums;
    }
  </style>
</head>

<body class="min-h-screen flex flex-col antialiased selection:bg-orange-100 selection:text-orange-900">

  <!-- Header dùng chung -->
  <%- include('partials/header', { activePage: 'home' }) %>

  <%
    const safeWarranties = Array.isArray(warranties) ? warranties : [];
    const safeAlerts = Array.isArray(expiringAlerts) ? expiringAlerts : [];
    const safeKpis = kpis || { total: safeWarranties.length, expiringSoon: safeAlerts.length, processing: 0, completed: 0 };
    const statusOptions = [
      { value: '', label: 'Tất cả' },
      { value: 'Tiếp nhận', label: 'Tiếp nhận' },
      { value: 'Đang kiểm tra', label: 'Đang kiểm tra' },
      { value: 'Chờ linh kiện', label: 'Chờ linh kiện' },
      { value: 'Đã sửa xong', label: 'Đã sửa xong' },
      { value: 'Đã trả khách', label: 'Đã trả khách' }
    ];

    function getStatusBadgeClass(st) {
      switch (st) {
        case 'Tiếp nhận':
          return 'bg-slate-100 text-slate-700 border-slate-200';
        case 'Đang kiểm tra':
          return 'bg-sky-50 text-sky-700 border-sky-200/80';
        case 'Chờ linh kiện':
          return 'bg-amber-50 text-amber-700 border-amber-200/80';
        case 'Đã sửa xong':
        case 'Đã trả khách':
          return 'bg-emerald-50 text-emerald-700 border-emerald-200/80';
        case 'Từ chối bảo hành':
          return 'bg-rose-50 text-rose-700 border-rose-200/80';
        default:
          return 'bg-slate-100 text-slate-700 border-slate-200';
      }
    }

    function getStatusDotClass(st) {
      switch (st) {
        case 'Tiếp nhận': return 'bg-slate-400';
        case 'Đang kiểm tra': return 'bg-sky-500';
        case 'Chờ linh kiện': return 'bg-amber-500';
        case 'Đã sửa xong':
        case 'Đã trả khách': return 'bg-emerald-500';
        case 'Từ chối bảo hành': return 'bg-rose-500';
        default: return 'bg-slate-400';
      }
    }

    function formatDateVN(d) {
      if (!d) return '—';
      try {
        return new Date(d).toLocaleDateString('vi-VN');
      } catch (e) {
        return '—';
      }
    }
  %>

  <main class="flex-1 w-full max-w-[1240px] mx-auto px-4 sm:px-6 py-7 space-y-6">

    <!-- Flash Notifications -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div id="flashSuccess" class="flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium">
        <div class="flex items-center gap-2.5">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <span><%= successMessage %></span>
        </div>
        <button type="button" onclick="this.parentElement.remove()" class="text-emerald-600 hover:text-emerald-900 p-1">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    <% } %>

    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div id="flashError" class="flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-medium">
        <div class="flex items-center gap-2.5">
          <svg class="w-4 h-4 text-rose-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span><%= errorMessage %></span>
        </div>
        <button type="button" onclick="this.parentElement.remove()" class="text-rose-600 hover:text-rose-900 p-1">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    <% } %>

    <!-- 1. WORKSPACE HEADER -->
    <section class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-2">
      <div class="space-y-1.5">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-white border border-slate-200 text-xs font-medium text-slate-600">
          <span class="w-2 h-2 rounded-full <%= dbConnected ? 'bg-emerald-500' : 'bg-amber-500' %>"></span>
          <span><%= dbConnected ? 'MongoDB đã kết nối' : 'Chế độ Dữ liệu mẫu' %></span>
          <span class="text-slate-300">·</span>
          <span class="text-slate-500">Không gian Quản lý Bảo hành</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900">
          Hồ sơ &amp; Phiếu Bảo hành
        </h1>
        <p class="text-sm text-slate-500 max-w-2xl">
          Lưu trữ giấy tờ bảo hành, theo dõi cảnh báo sắp hết hạn và phân tích AI đề xuất trạm tiếp nhận gần địa chỉ trên phiếu.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 shrink-0">
        <a href="/tra-cuu"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-700 text-sm font-semibold hover:bg-slate-50 hover:border-slate-300 transition-colors">
          <svg class="w-4 h-4 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          Tra cứu Serial
        </a>
        <button type="button" onclick="openCreateModal()"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-orange-600 hover:bg-orange-700 text-white text-sm font-semibold shadow-sm transition-colors cursor-pointer">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Thêm giấy / phiếu mới
        </button>
      </div>
    </section>

    <!-- 2. SUMMARY KPI STRIP -->
    <section class="grid grid-cols-2 lg:grid-cols-4 gap-3.5">
      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-[0_1px_2px_rgba(15,23,42,0.03)]">
        <div class="flex items-center justify-between text-xs font-semibold text-slate-500">
          <span>Tổng hồ sơ lưu trữ</span>
          <span class="w-7 h-7 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
          </span>
        </div>
        <div class="mt-2.5 flex items-baseline gap-2">
          <span class="text-2xl font-extrabold text-slate-900 tabular-nums"><%= safeKpis.total %></span>
          <span class="text-xs text-slate-400 font-medium">phiếu &amp; giấy tờ</span>
        </div>
      </div>

      <a href="#expiryAlertPanel" class="block bg-white border border-slate-200/90 hover:border-amber-300 rounded-2xl p-4 shadow-[0_1px_2px_rgba(15,23,42,0.03)] transition-colors">
        <div class="flex items-center justify-between text-xs font-semibold text-slate-500">
          <span>Sắp hết hạn (≤ 30 ngày)</span>
          <span class="w-7 h-7 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </span>
        </div>
        <div class="mt-2.5 flex items-baseline gap-2">
          <span class="text-2xl font-extrabold text-amber-600 tabular-nums"><%= safeAlerts.length %></span>
          <span class="text-xs text-amber-600/80 font-medium">cần lưu ý</span>
        </div>
      </a>

      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-[0_1px_2px_rgba(15,23,42,0.03)]">
        <div class="flex items-center justify-between text-xs font-semibold text-slate-500">
          <span>Đang xử lý kỹ thuật</span>
          <span class="w-7 h-7 rounded-lg bg-sky-50 text-sky-600 flex items-center justify-center">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
          </span>
        </div>
        <div class="mt-2.5 flex items-baseline gap-2">
          <span class="text-2xl font-extrabold text-slate-900 tabular-nums"><%= safeKpis.processing %></span>
          <span class="text-xs text-slate-400 font-medium">đang tiếp nhận / sửa</span>
        </div>
      </div>

      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-[0_1px_2px_rgba(15,23,42,0.03)]">
        <div class="flex items-center justify-between text-xs font-semibold text-slate-500">
          <span>Hoàn tất / Đã trả</span>
          <span class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
        </div>
        <div class="mt-2.5 flex items-baseline gap-2">
          <span class="text-2xl font-extrabold text-slate-900 tabular-nums"><%= safeKpis.completed %></span>
          <span class="text-xs text-slate-400 font-medium">hồ sơ đã đóng</span>
        </div>
      </div>
    </section>

    <!-- 3. MAIN 2-COLUMN WORKSPACE -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

      <!-- LEFT COLUMN (8/12): KHO HỒ SƠ & PHIẾU BẢO HÀNH -->
      <div class="lg:col-span-8 bg-white border border-slate-200/90 rounded-2xl shadow-[0_1px_3px_rgba(15,23,42,0.04)] overflow-hidden">

        <!-- Search & Filter Toolbar -->
        <div class="p-4 sm:p-5 border-b border-slate-100 space-y-3.5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <h2 class="text-base font-bold text-slate-900">Danh sách Giấy tờ &amp; Phiếu Bảo hành</h2>
              <p class="text-xs text-slate-500 mt-0.5">Chọn một phiếu để xem chi tiết, cập nhật hoặc phân tích địa chỉ bằng AI.</p>
            </div>
            <span class="text-xs font-mono text-slate-500 bg-slate-100 px-2.5 py-1 rounded-lg self-start sm:self-auto tabular-nums">
              Hiển thị <%= safeWarranties.length %> hồ sơ
            </span>
          </div>

          <form action="/" method="GET" class="flex flex-col sm:flex-row gap-2.5">
            <% if (statusFilter) { %>
              <input type="hidden" name="status" value="<%= statusFilter %>">
            <% } %>
            <div class="relative flex-1">
              <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input type="text" name="search" value="<%= searchQuery || '' %>"
                placeholder="Tìm theo mã phiếu, Serial/IMEI, tên thiết bị, SĐT hoặc địa chỉ..."
                class="w-full pl-10 pr-4 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
            </div>
            <button type="submit"
              class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold transition-colors cursor-pointer shrink-0">
              Tìm kiếm
            </button>
            <% if (searchQuery || statusFilter) { %>
              <a href="/"
                class="px-3.5 py-2 rounded-xl bg-white border border-slate-200 hover:bg-slate-50 text-slate-600 text-sm font-medium inline-flex items-center justify-center shrink-0">
                Xóa lọc
              </a>
            <% } %>
          </form>

          <!-- Status Filter Pills -->
          <div class="flex items-center gap-1.5 overflow-x-auto pb-0.5">
            <% statusOptions.forEach(opt => {
              const isActive = (statusFilter || '') === opt.value;
              const qs = new URLSearchParams();
              if (searchQuery) qs.set('search', searchQuery);
              if (opt.value) qs.set('status', opt.value);
              const href = qs.toString() ? '/?' + qs.toString() : '/';
            %>
              <a href="<%= href %>"
                class="px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors <%= isActive ? 'bg-orange-50 text-orange-700 border border-orange-200' : 'text-slate-600 hover:bg-slate-100 border border-transparent' %>">
                <%= opt.label %>
              </a>
            <% }) %>
          </div>
        </div>

        <!-- Warranties List -->
        <% if (safeWarranties.length === 0) { %>
          <div class="p-12 text-center space-y-3">
            <div class="w-11 h-11 rounded-full bg-slate-100 text-slate-400 mx-auto flex items-center justify-center">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </div>
            <div class="text-sm font-semibold text-slate-800">Không tìm thấy hồ sơ bảo hành phù hợp</div>
            <p class="text-xs text-slate-500 max-w-sm mx-auto">
              Thử đổi từ khóa tìm kiếm, bỏ bộ lọc trạng thái hoặc tạo hồ sơ bảo hành mới.
            </p>
            <div class="pt-1 flex items-center justify-center gap-2">
              <a href="/" class="px-3.5 py-2 rounded-lg border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50">Xem tất cả</a>
              <button type="button" onclick="openCreateModal()" class="px-3.5 py-2 rounded-lg bg-orange-600 text-white text-xs font-semibold hover:bg-orange-700 cursor-pointer">+ Tạo hồ sơ mới</button>
            </div>
          </div>
        <% } else { %>
          <div class="divide-y divide-slate-100">
            <% safeWarranties.forEach((item, index) => {
              const dLeft = typeof item.daysLeft === 'number' ? item.daysLeft : null;
              let expiryLabel = 'Chưa rõ hạn';
              let expiryClass = 'text-slate-500 bg-slate-100';
              if (dLeft !== null) {
                if (dLeft < 0) {
                  expiryLabel = 'Hết hạn ' + Math.abs(dLeft) + ' ngày';
                  expiryClass = 'text-rose-700 bg-rose-50 border border-rose-200/70';
                } else if (dLeft <= 7) {
                  expiryLabel = 'Còn ' + dLeft + ' ngày';
                  expiryClass = 'text-rose-700 bg-rose-50 border border-rose-200/70';
                } else if (dLeft <= 30) {
                  expiryLabel = 'Còn ' + dLeft + ' ngày';
                  expiryClass = 'text-amber-700 bg-amber-50 border border-amber-200/70';
                } else {
                  expiryLabel = 'Còn ' + dLeft + ' ngày';
                  expiryClass = 'text-slate-600 bg-slate-100';
                }
              }
            %>
              <div class="p-4 sm:px-5 hover:bg-slate-50/70 transition-colors">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                  <!-- Main Info -->
                  <div class="space-y-1.5 min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="font-mono text-xs font-semibold text-slate-900 bg-slate-100 px-2 py-0.5 rounded-md">
                        <%= item.warrantyCode %>
                      </span>
                      <span class="font-mono text-xs text-slate-500">
                        SN: <%= item.productSerial %>
                      </span>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full border text-[11px] font-semibold <%= getStatusBadgeClass(item.status) %>">
                        <span class="w-1.5 h-1.5 rounded-full <%= getStatusDotClass(item.status) %>"></span>
                        <%= item.status %>
                      </span>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold tabular-nums <%= expiryClass %>">
                        <%= expiryLabel %>
                      </span>
                    </div>

                    <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                      <h3 class="text-sm font-bold text-slate-900"><%= item.productName %></h3>
                      <span class="text-xs text-slate-400">·</span>
                      <span class="text-xs font-medium text-slate-600"><%= item.category || 'Thiết bị' %></span>
                    </div>

                    <p class="text-xs text-slate-500 line-clamp-1">
                      <span class="font-medium text-slate-700"><%= item.customerName %></span>
                      (<%= item.customerPhone %>) — <%= item.issueDescription %>
                    </p>

                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 pt-0.5 text-xs text-slate-500">
                      <span class="inline-flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                          <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <span class="<%= item.customerAddress ? 'text-slate-700 font-medium' : 'italic text-slate-400' %>">
                          <%= item.customerAddress || 'Chưa ghi địa chỉ trên phiếu' %>
                        </span>
                      </span>
                      <% if (item.warrantyExpiryDate) { %>
                        <span class="inline-flex items-center gap-1 text-slate-400">
                          <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                          </svg>
                          Hạn BH: <%= formatDateVN(item.warrantyExpiryDate) %>
                        </span>
                      <% } %>
                    </div>
                  </div>

                  <!-- Row Actions -->
                  <div class="flex items-center gap-1.5 shrink-0 sm:pt-0.5">
                    <button type="button" onclick="analyzeTicketByIndex(<%= index %>)"
                      title="Dùng AI phân tích địa chỉ &amp; gợi ý chi nhánh gần nhất"
                      class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-orange-50 hover:bg-orange-100 text-orange-700 border border-orange-200/80 text-xs font-semibold transition-colors cursor-pointer">
                      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
                      </svg>
                      Gợi ý trạm AI
                    </button>
                    <button type="button" onclick="openDetailModal(<%= index %>)"
                      class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs font-semibold transition-colors cursor-pointer">
                      Chi tiết
                    </button>
                    <a href="/tra-cuu?serial=<%= encodeURIComponent(item.productSerial || item.warrantyCode) %>"
                      title="Mở trang tra cứu công khai"
                      class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 border border-transparent hover:border-slate-200 transition-colors">
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- RIGHT COLUMN (4/12): CẢNH BÁO HẾT HẠN & AI PHÂN TÍCH ĐỊA CHỈ -->
      <div class="lg:col-span-4 space-y-6">

        <!-- PANEL A: CẢNH BÁO SẮP HẾT HẠN -->
        <div id="expiryAlertPanel" class="bg-white border border-slate-200/90 rounded-2xl shadow-[0_1px_3px_rgba(15,23,42,0.04)] overflow-hidden">
          <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-amber-500"></span>
              <h2 class="text-sm font-bold text-slate-900">Cảnh báo Sắp hết hạn</h2>
            </div>
            <span class="text-[11px] font-semibold text-amber-700 bg-amber-50 border border-amber-200/80 px-2 py-0.5 rounded-full tabular-nums">
              <%= safeAlerts.length %> thiết bị
            </span>
          </div>

          <div class="divide-y divide-slate-100">
            <% if (safeAlerts.length === 0) { %>
              <div class="p-6 text-center text-xs text-slate-500">
                Không có hồ sơ nào sắp hết hạn trong 30 ngày tới.
              </div>
            <% } else { %>
              <% safeAlerts.slice(0, 5).forEach(alertItem => {
                const urgent = alertItem.daysLeft <= 5;
                const pct = Math.max(8, Math.min(100, Math.round((1 - Math.max(0, alertItem.daysLeft) / 30) * 100)));
              %>
                <div class="p-4 space-y-2 hover:bg-slate-50/70 transition-colors">
                  <div class="flex items-start justify-between gap-2">
                    <div class="min-w-0">
                      <div class="text-sm font-bold text-slate-900 truncate"><%= alertItem.name %></div>
                      <div class="text-xs text-slate-500 mt-0.5">
                        <%= alertItem.customer %> · <span class="font-mono"><%= alertItem.phone %></span>
                      </div>
                    </div>
                    <span class="shrink-0 px-2 py-0.5 rounded-md text-[11px] font-bold tabular-nums <%= urgent ? 'bg-rose-50 text-rose-700 border border-rose-200/80' : 'bg-amber-50 text-amber-700 border border-amber-200/80' %>">
                      <%= alertItem.daysLeft < 0 ? 'Quá hạn ' + Math.abs(alertItem.daysLeft) + 'd' : 'Còn ' + alertItem.daysLeft + ' ngày' %>
                    </span>
                  </div>

                  <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
                    <div class="h-full rounded-full <%= urgent ? 'bg-rose-500' : 'bg-amber-500' %>" style="width: <%= pct %>%"></div>
                  </div>

                  <div class="flex items-center justify-between pt-0.5 text-[11px]">
                    <span class="font-mono text-slate-400"><%= alertItem.warrantyCode || alertItem.productSerial %></span>
                    <div class="flex items-center gap-3">
                      <% if (alertItem.customerAddress) { %>
                        <button type="button"
                          onclick="runAddressAnalysis(<%= JSON.stringify(alertItem.customerAddress) %>, '', 'Thiết bị sắp hết hạn bảo hành cần kiểm tra tổng quát')"
                          class="font-semibold text-slate-600 hover:text-orange-600 cursor-pointer">
                          Tìm trạm
                        </button>
                      <% } %>
                      <button type="button"
                        onclick="prefillCreateModal(<%= JSON.stringify({ productName: alertItem.name, productSerial: alertItem.productSerial || '', customerName: alertItem.customer, customerPhone: alertItem.phone, customerAddress: alertItem.customerAddress || '' }) %>)"
                        class="font-semibold text-orange-600 hover:text-orange-700 cursor-pointer">
                        Tạo phiếu kiểm tra →
                      </button>
                    </div>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>

        <!-- PANEL B: TRỢ LÝ AI PHÂN TÍCH ĐỊA CHỈ & GỢI Ý CHI NHÁNH -->
        <div id="aiAdvisorPanel" class="bg-white border border-slate-200/90 rounded-2xl shadow-[0_1px_3px_rgba(15,23,42,0.04)] overflow-hidden">
          <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-xl bg-slate-900 text-white flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
                </svg>
              </div>
              <div>
                <h2 class="text-sm font-bold text-slate-900">AI Gợi ý Chi nhánh</h2>
                <p class="text-[11px] text-slate-500">Phân tích địa chỉ trên giấy bảo hành</p>
              </div>
            </div>
            <span class="text-[11px] font-semibold text-slate-600 bg-slate-100 px-2 py-0.5 rounded-md">
              5 trạm
            </span>
          </div>

          <div class="p-4 sm:p-5 space-y-4">
            <!-- Quick Select from Tickets -->
            <% if (safeWarranties.length > 0) { %>
              <div class="space-y-1.5">
                <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-400">
                  Lấy nhanh từ hồ sơ có địa chỉ
                </label>
                <div class="flex flex-wrap gap-1.5">
                  <% safeWarranties.filter(w => w.customerAddress).slice(0, 4).forEach((w, i) => { %>
                    <button type="button"
                      onclick="selectTicketForAI(<%= JSON.stringify({ warrantyCode: w.warrantyCode, address: w.customerAddress, category: w.category || '', issueDescription: w.issueDescription || '' }) %>)"
                      class="px-2.5 py-1 rounded-lg border border-slate-200 bg-slate-50 hover:border-orange-300 hover:bg-orange-50/60 text-[11px] font-medium text-slate-700 transition-colors cursor-pointer">
                      <span class="font-mono font-semibold"><%= w.warrantyCode %></span>
                    </button>
                  <% }) %>
                </div>
              </div>
            <% } %>

            <!-- Address Input Form -->
            <form id="aiBranchForm" onsubmit="handleAiSubmit(event)" class="space-y-2.5">
              <div>
                <label for="aiAddressInput" class="block text-xs font-semibold text-slate-700 mb-1">
                  Địa chỉ trên phiếu / giấy bảo hành
                </label>
                <input type="text" id="aiAddressInput"
                  value="<%= activeTicket && activeTicket.customerAddress ? activeTicket.customerAddress : 'Số 45 Trần Thái Tông, Cầu Giấy, Hà Nội' %>"
                  placeholder="VD: Quận 1, TP. Hồ Chí Minh hoặc Cầu Giấy, Hà Nội..."
                  class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500"
                  required>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                <select id="aiCategorySelect"
                  class="px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl text-slate-700 focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
                  <option value="">Nhóm thiết bị (tùy chọn)</option>
                  <option value="Laptop/Máy tính" <%= activeTicket && activeTicket.category === 'Laptop/Máy tính' ? 'selected' : '' %>>Laptop/Máy tính</option>
                  <option value="Điện thoại" <%= activeTicket && activeTicket.category === 'Điện thoại' ? 'selected' : '' %>>Điện thoại</option>
                  <option value="Thiết bị gia dụng">Thiết bị gia dụng</option>
                  <option value="Phụ kiện">Phụ kiện</option>
                </select>
                <button type="submit" id="aiAnalyzeBtn"
                  class="px-3.5 py-2 rounded-xl bg-orange-600 hover:bg-orange-700 text-white text-xs font-semibold transition-colors cursor-pointer inline-flex items-center justify-center gap-1.5">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"></path>
                  </svg>
                  Phân tích &amp; Gợi ý
                </button>
              </div>
            </form>

            <!-- AI Result Output -->
            <div id="aiResultContainer" class="rounded-xl border border-slate-200 bg-slate-50/70 p-3.5 space-y-3">
              <% if (defaultSuggestion && defaultSuggestion.matched) { %>
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <div class="text-[11px] font-semibold uppercase tracking-wider text-orange-600">Đề xuất tối ưu nhất</div>
                    <div class="text-sm font-bold text-slate-900 mt-0.5"><%= defaultSuggestion.primary.name %></div>
                  </div>
                  <span class="shrink-0 px-2 py-0.5 rounded-md bg-emerald-50 border border-emerald-200 text-emerald-700 text-[11px] font-bold tabular-nums">
                    Phù hợp <%= defaultSuggestion.confidence %>%
                  </span>
                </div>

                <div class="text-xs text-slate-600 space-y-1">
                  <div class="flex items-start gap-1.5">
                    <svg class="w-3.5 h-3.5 text-slate-400 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    <span><%= defaultSuggestion.primary.address %></span>
                  </div>
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-slate-500 pl-5">
                    <span>Ước tính: <strong class="text-slate-700"><%= defaultSuggestion.primary.distanceText %></strong></span>
                    <span>·</span>
                    <span><%= defaultSuggestion.primary.loadLabel %> (<%= defaultSuggestion.primary.loadPercent %>%)</span>
                    <span>·</span>
                    <span>SLA <%= defaultSuggestion.primary.slaHours %>h</span>
                  </div>
                </div>

                <div class="text-xs text-slate-600 bg-white border border-slate-200/80 rounded-lg p-2.5 leading-relaxed">
                  <span class="font-semibold text-slate-800">Lý do AI chọn:</span>
                  <%= defaultSuggestion.primary.reason %>
                </div>

                <% if (defaultSuggestion.alternatives && defaultSuggestion.alternatives.length > 0) { %>
                  <div class="space-y-1 pt-1">
                    <div class="text-[11px] font-semibold text-slate-400">Chi nhánh dự phòng khác</div>
                    <% defaultSuggestion.alternatives.forEach(alt => { %>
                      <div class="flex items-center justify-between text-xs py-1 border-t border-slate-200/60">
                        <span class="font-medium text-slate-700 truncate pr-2"><%= alt.name %></span>
                        <span class="text-[11px] text-slate-500 shrink-0"><%= alt.loadLabel %></span>
                      </div>
                    <% }) %>
                  </div>
                <% } %>
              <% } else { %>
                <p class="text-xs text-slate-500">Nhập địa chỉ bất kỳ trên giấy bảo hành để hệ thống phân tích trạm phù hợp.</p>
              <% } %>
            </div>
          </div>
        </div>

      </div>
    </section>

  </main>

  <!-- Footer dùng chung -->
  <%- include('partials/footer') %>

  <!-- ==============================================
       MODAL 1: THÊM HỒ SƠ / GIẤY BẢO HÀNH MỚI
  ============================================== -->
  <div id="createModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 backdrop-blur-[2px] p-4">
    <div class="bg-white border border-slate-200 rounded-2xl shadow-xl w-full max-w-xl max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between sticky top-0 bg-white z-10">
        <div>
          <h3 class="text-base font-bold text-slate-900">Thêm Hồ sơ / Phiếu Bảo hành</h3>
          <p class="text-xs text-slate-500">Nhập thông tin giấy bảo hành và địa chỉ để hệ thống theo dõi hạn &amp; gợi ý trạm.</p>
        </div>
        <button type="button" onclick="closeCreateModal()" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 cursor-pointer">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <form action="/warranty/create" method="POST" class="p-6 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <div>
            <label for="c_warrantyCode" class="block text-xs font-semibold text-slate-700 mb-1">Mã phiếu (tự tạo nếu để trống)</label>
            <input type="text" id="c_warrantyCode" name="warrantyCode" placeholder="VD: TKT-2024-9001"
              class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
          </div>
          <div>
            <label for="c_category" class="block text-xs font-semibold text-slate-700 mb-1">Phân loại thiết bị</label>
            <select id="c_category" name="category"
              class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
              <option value="Laptop/Máy tính">Laptop/Máy tính</option>
              <option value="Điện thoại">Điện thoại</option>
              <option value="Thiết bị gia dụng">Thiết bị gia dụng</option>
              <option value="Phụ kiện">Phụ kiện</option>
              <option value="Khác">Khác</option>
            </select>
          </div>

          <div>
            <label for="c_productName" class="block text-xs font-semibold text-slate-700 mb-1">Tên sản phẩm / Model <span class="text-rose-500">*</span></label>
            <input type="text" id="c_productName" name="productName" required placeholder="Dell XPS 15 9530"
              class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
          </div>
          <div>
            <label for="c_productSerial" class="block text-xs font-semibold text-slate-700 mb-1">Số Serial / IMEI <span class="text-rose-500">*</span></label>
            <input type="text" id="c_productSerial" name="productSerial" required placeholder="DL-992810"
              class="w-full px-3 py-2 text-sm font-mono bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
          </div>

          <div>
            <label for="c_customerName" class="block text-xs font-semibold text-slate-700 mb-1">Tên khách hàng <span class="text-rose-500">*</span></label>
            <input type="text" id="c_customerName" name="customerName" required placeholder="Nguyễn Văn A"
              class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
          </div>
          <div>
            <label for="c_customerPhone" class="block text-xs font-semibold text-slate-700 mb-1">Số điện thoại <span class="text-rose-500">*</span></label>
            <input type="tel" id="c_customerPhone" name="customerPhone" required placeholder="0901234567"
              class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
          </div>

          <div class="sm:col-span-2">
            <label for="c_customerAddress" class="block text-xs font-semibold text-slate-700 mb-1">
              Địa chỉ trên giấy bảo hành <span class="text-slate-400 font-normal">(dùng để AI gợi ý chi nhánh gần nhất)</span>
            </label>
            <input type="text" id="c_customerAddress" name="customerAddress" placeholder="VD: Số 45 Trần Thái Tông, Cầu Giấy, Hà Nội"
              class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
          </div>

          <div>
            <label for="c_purchaseDate" class="block text-xs font-semibold text-slate-700 mb-1">Ngày mua / kích hoạt</label>
            <input type="date" id="c_purchaseDate" name="purchaseDate"
              class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
          </div>
          <div>
            <label for="c_warrantyPeriodMonths" class="block text-xs font-semibold text-slate-700 mb-1">Thời hạn bảo hành</label>
            <select id="c_warrantyPeriodMonths" name="warrantyPeriodMonths"
              class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
              <option value="6">6 tháng</option>
              <option value="12" selected>12 tháng</option>
              <option value="24">24 tháng</option>
              <option value="36">36 tháng</option>
            </select>
          </div>

          <div class="sm:col-span-2">
            <label for="c_issueDescription" class="block text-xs font-semibold text-slate-700 mb-1">Nội dung / Tình trạng lỗi <span class="text-rose-500">*</span></label>
            <textarea id="c_issueDescription" name="issueDescription" rows="2" required placeholder="Mô tả tình trạng máy hoặc nội dung lưu trữ bảo hành..."
              class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500"></textarea>
          </div>
        </div>

        <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2.5">
          <button type="button" onclick="closeCreateModal()" class="px-4 py-2 rounded-xl border border-slate-200 text-slate-700 text-sm font-semibold hover:bg-slate-50 cursor-pointer">Hủy</button>
          <button type="submit" class="px-4 py-2 rounded-xl bg-orange-600 hover:bg-orange-700 text-white text-sm font-semibold cursor-pointer">Lưu hồ sơ</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ==============================================
       MODAL 2: CHI TIẾT & CẬP NHẬT HỒ SƠ BẢO HÀNH
  ============================================== -->
  <div id="detailModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 backdrop-blur-[2px] p-4">
    <div class="bg-white border border-slate-200 rounded-2xl shadow-xl w-full max-w-xl max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between sticky top-0 bg-white z-10">
        <div class="flex items-center gap-2.5">
          <span id="d_codeBadge" class="font-mono text-xs font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-900"></span>
          <h3 id="d_productTitle" class="text-base font-bold text-slate-900 truncate"></h3>
        </div>
        <button type="button" onclick="closeDetailModal()" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 cursor-pointer">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div class="p-6 space-y-5">
        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-4 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div>
            <span class="text-slate-400 block">Khách hàng</span>
            <span id="d_customer" class="font-semibold text-slate-800"></span>
          </div>
          <div>
            <span class="text-slate-400 block">Serial / IMEI</span>
            <span id="d_serial" class="font-mono font-semibold text-slate-800"></span>
          </div>
          <div class="sm:col-span-2">
            <span class="text-slate-400 block">Mô tả lỗi / Ghi chú giấy bảo hành</span>
            <span id="d_issue" class="text-slate-700"></span>
          </div>
        </div>

        <form id="updateWarrantyForm" method="POST" class="space-y-3.5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div>
              <label for="d_status" class="block text-xs font-semibold text-slate-700 mb-1">Trạng thái xử lý</label>
              <select id="d_status" name="status"
                class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
                <option value="Tiếp nhận">Tiếp nhận</option>
                <option value="Đang kiểm tra">Đang kiểm tra</option>
                <option value="Chờ linh kiện">Chờ linh kiện</option>
                <option value="Đã sửa xong">Đã sửa xong</option>
                <option value="Đã trả khách">Đã trả khách</option>
                <option value="Từ chối bảo hành">Từ chối bảo hành</option>
              </select>
            </div>
            <div>
              <label for="d_repairCost" class="block text-xs font-semibold text-slate-700 mb-1">Chi phí sửa chữa (VNĐ)</label>
              <input type="number" id="d_repairCost" name="repairCost" min="0" step="10000"
                class="w-full px-3 py-2 text-sm font-mono bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
            </div>
            <div class="sm:col-span-2">
              <label for="d_address" class="block text-xs font-semibold text-slate-700 mb-1">Địa chỉ trên hồ sơ</label>
              <input type="text" id="d_address" name="customerAddress"
                class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
            </div>
            <div class="sm:col-span-2">
              <label for="d_notes" class="block text-xs font-semibold text-slate-700 mb-1">Ghi chú kỹ thuật / Chi nhánh tiếp nhận</label>
              <textarea id="d_notes" name="technicianNotes" rows="3"
                class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500"></textarea>
            </div>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-3">
            <button type="button" onclick="submitDeleteWarranty()"
              class="px-3.5 py-2 rounded-xl text-rose-600 hover:bg-rose-50 border border-transparent hover:border-rose-200 text-xs font-semibold transition-colors cursor-pointer">
              Xóa hồ sơ
            </button>
            <div class="flex items-center gap-2">
              <button type="button" onclick="closeDetailModal()" class="px-4 py-2 rounded-xl border border-slate-200 text-slate-700 text-sm font-semibold hover:bg-slate-50 cursor-pointer">Đóng</button>
              <button type="submit" class="px-4 py-2 rounded-xl bg-orange-600 hover:bg-orange-700 text-white text-sm font-semibold cursor-pointer">Cập nhật</button>
            </div>
          </div>
        </form>

        <form id="deleteWarrantyForm" method="POST" class="hidden"></form>
      </div>
    </div>
  </div>

  <script>
    const WARRANTIES_DATA = <%- JSON.stringify(safeWarranties).replace(/</g, '\\u003c') %>;
    let currentDetailId = null;

    function toggleModal(id, show) {
      const el = document.getElementById(id);
      if (!el) return;
      if (show) {
        el.classList.remove('hidden');
        el.classList.add('flex');
      } else {
        el.classList.add('hidden');
        el.classList.remove('flex');
      }
    }

    function openCreateModal() {
      const dateInput = document.getElementById('c_purchaseDate');
      if (dateInput && !dateInput.value) {
        dateInput.value = new Date().toISOString().split('T')[0];
      }
      toggleModal('createModal', true);
    }

    function closeCreateModal() {
      toggleModal('createModal', false);
    }

    function prefillCreateModal(data) {
      document.getElementById('c_productName').value = data.productName || '';
      document.getElementById('c_productSerial').value = data.productSerial || '';
      document.getElementById('c_customerName').value = data.customerName || '';
      document.getElementById('c_customerPhone').value = data.customerPhone || '';
      document.getElementById('c_customerAddress').value = data.customerAddress || '';
      document.getElementById('c_issueDescription').value = 'Kiểm tra / gia hạn thiết bị sắp hết hạn bảo hành';
      openCreateModal();
    }

    function openDetailModal(index) {
      const item = WARRANTIES_DATA[index];
      if (!item) return;
      currentDetailId = item._id;

      document.getElementById('d_codeBadge').textContent = item.warrantyCode || '';
      document.getElementById('d_productTitle').textContent = item.productName || '';
      document.getElementById('d_customer').textContent = `${item.customerName || ''} (${item.customerPhone || ''})`;
      document.getElementById('d_serial').textContent = item.productSerial || '';
      document.getElementById('d_issue').textContent = item.issueDescription || '';
      document.getElementById('d_status').value = item.status || 'Tiếp nhận';
      document.getElementById('d_repairCost').value = item.repairCost || 0;
      document.getElementById('d_address').value = item.customerAddress || '';
      document.getElementById('d_notes').value = item.technicianNotes || '';

      document.getElementById('updateWarrantyForm').action = '/warranty/update/' + encodeURIComponent(item._id);
      document.getElementById('deleteWarrantyForm').action = '/warranty/delete/' + encodeURIComponent(item._id);
      toggleModal('detailModal', true);
    }

    function closeDetailModal() {
      toggleModal('detailModal', false);
    }

    function submitDeleteWarranty() {
      if (!currentDetailId) return;
      if (confirm('Bạn có chắc chắn muốn xóa hồ sơ bảo hành này không?')) {
        document.getElementById('deleteWarrantyForm').submit();
      }
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function selectTicketForAI(ticket) {
      document.getElementById('aiAddressInput').value = ticket.address || '';
      if (ticket.category) {
        document.getElementById('aiCategorySelect').value = ticket.category;
      }
      runAddressAnalysis(ticket.address || '', ticket.category || '', ticket.issueDescription || '');
    }

    function analyzeTicketByIndex(index) {
      const item = WARRANTIES_DATA[index];
      if (!item) return;
      const addr = item.customerAddress || '';
      document.getElementById('aiAddressInput').value = addr;
      if (item.category) {
        document.getElementById('aiCategorySelect').value = item.category;
      }
      document.getElementById('aiAdvisorPanel').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      if (!addr) {
        document.getElementById('aiAddressInput').focus();
        document.getElementById('aiResultContainer').innerHTML =
          '<p class="text-xs text-amber-700 font-medium">Phiếu <strong>' + escapeHtml(item.warrantyCode) + '</strong> chưa có địa chỉ. Hãy nhập địa chỉ khách hàng để AI phân tích trạm gần nhất.</p>';
        return;
      }
      runAddressAnalysis(addr, item.category || '', item.issueDescription || '');
    }

    function handleAiSubmit(e) {
      e.preventDefault();
      const address = document.getElementById('aiAddressInput').value;
      const category = document.getElementById('aiCategorySelect').value;
      runAddressAnalysis(address, category, '');
    }

    async function runAddressAnalysis(address, category, issueDescription) {
      const container = document.getElementById('aiResultContainer');
      const btn = document.getElementById('aiAnalyzeBtn');
      const originalBtn = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Đang phân tích...';

      try {
        const res = await fetch('/api/ai/suggest-branch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ address, category, issueDescription })
        });
        const data = await res.json();

        if (!data.matched) {
          container.innerHTML = `<p class="text-xs text-slate-600">${escapeHtml(data.message)}</p>`;
          return;
        }

        const p = data.primary;
        const altsHtml = (data.alternatives || []).map(alt => `
          <div class="flex items-center justify-between text-xs py-1 border-t border-slate-200/60">
            <span class="font-medium text-slate-700 truncate pr-2">${escapeHtml(alt.name)}</span>
            <span class="text-[11px] text-slate-500 shrink-0">${escapeHtml(alt.loadLabel)}</span>
          </div>
        `).join('');

        container.innerHTML = `
          <div class="flex items-start justify-between gap-2">
            <div>
              <div class="text-[11px] font-semibold uppercase tracking-wider text-orange-600">Đề xuất tối ưu nhất</div>
              <div class="text-sm font-bold text-slate-900 mt-0.5">${escapeHtml(p.name)}</div>
            </div>
            <span class="shrink-0 px-2 py-0.5 rounded-md bg-emerald-50 border border-emerald-200 text-emerald-700 text-[11px] font-bold tabular-nums">
              Phù hợp ${escapeHtml(data.confidence)}%
            </span>
          </div>
          <div class="text-xs text-slate-600 space-y-1">
            <div class="flex items-start gap-1.5">
              <svg class="w-3.5 h-3.5 text-slate-400 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>${escapeHtml(p.address)}</span>
            </div>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-slate-500 pl-5">
              <span>Ước tính: <strong class="text-slate-700">${escapeHtml(p.distanceText)}</strong></span>
              <span>·</span>
              <span>${escapeHtml(p.loadLabel)} (${escapeHtml(p.loadPercent)}%)</span>
              <span>·</span>
              <span>SLA ${escapeHtml(p.slaHours)}h</span>
            </div>
          </div>
          <div class="text-xs text-slate-600 bg-white border border-slate-200/80 rounded-lg p-2.5 leading-relaxed">
            <span class="font-semibold text-slate-800">Lý do AI chọn:</span>
            ${escapeHtml(p.reason)}
          </div>
          ${altsHtml ? `<div class="space-y-1 pt-1"><div class="text-[11px] font-semibold text-slate-400">Chi nhánh dự phòng khác</div>${altsHtml}</div>` : ''}
        `;
      } catch (err) {
        container.innerHTML = '<p class="text-xs text-rose-600">Không thể kết nối dịch vụ phân tích địa chỉ. Vui lòng thử lại.</p>';
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalBtn;
      }
    }

    // Đóng modal khi click ra ngoài nền tối
    window.addEventListener('click', (e) => {
      if (e.target.id === 'createModal') closeCreateModal();
      if (e.target.id === 'detailModal') closeDetailModal();
    });
  </script>

</body>
</html>
