      const serial = document.getElementById('deviceSerial');
      const img = document.getElementById('deviceThumbImg');
      const hiddenName = document.getElementById('hiddenProductName');
      const hiddenSerial = document.getElementById('hiddenProductSerial');
      const hiddenCat = document.getElementById('hiddenCategory');

      if (val === 'dlxps-99281') {
        title.innerText = 'Dell XPS 15 9530 (Core i7 / 32GB / RTX 4060)';
        serial.innerText = 'S/N: DLXPS-99281-VN • Mua: 15/01/2024';
        img.src = 'https://images.unsplash.com/photo-1593642632823-8f785ba67e45?auto=format&fit=crop&w=150&q=80';
        hiddenName.value = 'Dell XPS 15 9530';
        hiddenSerial.value = 'DLXPS-99281-VN';
        hiddenCat.value = 'Laptop/Máy tính';
      } else if (val === 'mbp-14-3891') {
        title.innerText = 'MacBook Pro 14" M2 Pro (16GB / 512GB SSD)';
        serial.innerText = 'S/N: C02G901KA92 • Mua: 20/03/2023';
        img.src = 'https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=150&q=80';
        hiddenName.value = 'MacBook Pro 14 M2 Pro';
        hiddenSerial.value = 'C02G901KA92';
        hiddenCat.value = 'Laptop/Máy tính';
      } else if (val === 'lg-oled-42') {
        title.innerText = 'LG UltraGear OLED 27GR95QE 240Hz 0.03ms';
        serial.innerText = 'S/N: LG9881273 • Mua: 05/08/2023';
        img.src = 'https://images.unsplash.com/photo-1527443224154-c4a3942d3acf?auto=format&fit=crop&w=150&q=80';
        hiddenName.value = 'LG UltraGear OLED 27"';
        hiddenSerial.value = 'LG9881273';
        hiddenCat.value = 'Thiết bị gia dụng';
      }
    }

    function toggleIssueCategory(btn, catName) {
      btn.classList.toggle('bg-[#ff6b00]/10');
      btn.classList.toggle('text-[#a04100]');
      btn.classList.toggle('border-2');
      btn.classList.toggle('border-[#ff6b00]');
      btn.classList.toggle('font-semibold');
      btn.classList.toggle('bg-gray-50');
      btn.classList.toggle('text-gray-800');
      btn.classList.toggle('border-gray-200');

      const icon = btn.querySelector('.material-symbols-outlined');
      if (icon) {
        icon.classList.toggle('text-[#ff6b00]');
        icon.classList.toggle('text-gray-500');
      }
    }

    function handleFileSelect(e) {
      const files = e.target.files;
      if (files && files.length > 0) {
        alert('Đã đính kèm ' + files.length + ' tệp thành công vào hồ sơ bảo hành!');
      }
    }

    function openLoginModal() {
      document.getElementById('loginModal').classList.remove('hidden');
      document.getElementById('loginModal').classList.add('flex');
    }

    function closeLoginModal() {
      document.getElementById('loginModal').classList.add('hidden');
      document.getElementById('loginModal').classList.remove('flex');
    }
  </script>

</body>

</html>