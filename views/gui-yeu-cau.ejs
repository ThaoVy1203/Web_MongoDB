<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>Tạo Phiếu Yêu Cầu Bảo Hành - WarrantyOps Portal</title>

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Hanken+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet">
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">

  <style>
    @layer base {

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        overscroll-behavior: none;
      }
    }

    ::-webkit-scrollbar {
      display: none;
    }
  </style>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "surface-dim": "#dfd9cf",
            "inverse-surface": "#333029",
            "secondary-container": "#84a2fe",
            "on-surface-variant": "#444655",
            "surface-variant": "#e8e2d7",
            "on-error": "#ffffff",
            "on-primary-fixed": "#00115a",
            "on-secondary-fixed": "#00174b",
            "surface-tint": "#294ce5",
            "on-background": "#1d1b15",
            "primary": "#ff6b00",
            "brand-deep": "#003087",
            "brand-sky": "#99ccff",
            "tertiary-container": "#0f4f7b",
            "error-container": "#ffdad6",
            "on-secondary-container": "#09348b",
            "surface-container-high": "#ede7dd",
            "on-primary": "#ffffff",
            "on-secondary": "#ffffff",
            "on-tertiary-fixed-variant": "#034a76",
            "on-primary-fixed-variant": "#0030c6",
            "surface-container": "#f3ede2",
            "tertiary": "#00385b",
            "on-tertiary-container": "#8ec1f3",
            "surface-container-highest": "#e8e2d7",
            "on-secondary-fixed-variant": "#1c4197",
            "on-primary-container": "#acb8ff",
            "secondary-fixed": "#dbe1ff",
            "inverse-on-surface": "#f6f0e5",
            "surface-container-lowest": "#ffffff",
            "on-tertiary": "#ffffff",
            "outline-variant": "#c4c5d8",
            "tertiary-fixed-dim": "#98cbfe",
            "on-tertiary-fixed": "#001d33",
            "background": "#f2ece1",
            "primary-fixed-dim": "#bac3ff",
            "on-error-container": "#93000a",
            "primary-container": "#ff6b00",
            "tertiary-fixed": "#cee5ff",
            "secondary-fixed-dim": "#b4c5ff",
            "surface-bright": "#fff9ed",
            "outline": "#747687",
            "primary-fixed": "#dee0ff",
            "inverse-primary": "#bac3ff",
            "secondary": "#3959b0",
            "surface": "#fff9ed",
            "on-surface": "#1d1b15",
            "surface-container-low": "#f9f3e8",
            "error": "#ba1a1a"
          },
          borderRadius: {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          spacing: {
            "space-xs": "0.25rem",
            "margin-mobile": "1rem",
            "space-lg": "1.5rem",
            "space-xl": "2.5rem",
            "space-sm": "0.5rem",
            "space-md": "1rem",
            "gutter-mobile": "1rem",
            "gutter": "1.5rem",
            "margin": "2rem"
          },
          fontFamily: {
            "sans": ["Plus Jakarta Sans", "Hanken Grotesk", "sans-serif"],
            "body-lg": ["Plus Jakarta Sans", "sans-serif"],
            "headline-md": ["Plus Jakarta Sans", "sans-serif"],
            "headline-lg": ["Plus Jakarta Sans", "sans-serif"],
            "body-md": ["Plus Jakarta Sans", "sans-serif"],
            "headline-xl": ["Plus Jakarta Sans", "sans-serif"],
            "headline-xl-mobile": ["Plus Jakarta Sans", "sans-serif"],
            "label-sm": ["JetBrains Mono", "monospace"],
            "code-sm": ["JetBrains Mono", "monospace"],
            "label-md": ["JetBrains Mono", "monospace"],
            "body-sm": ["Plus Jakarta Sans", "sans-serif"],
            "headline-sm": ["Plus Jakarta Sans", "sans-serif"]
          }
        }
      }
    }
  </script>
</head>

<body class="bg-[#f8f9fa] text-[#1d1b15] font-sans antialiased">

  <!-- ==============================================
       1. TOP NAVBAR / HEADER
  ============================================== -->
  <header class="site-header">
    <div class="container header-wrap">
      <!-- Logo góc trên cùng bên trái với logo1.png -->
      <a href="/" class="brand-area">
        <img src="/images/logo1.png" alt="WarrantyOps Logo" class="brand-logo-img"
          onerror="this.onerror=null; this.src='/images/logo.png';">
      </a>

      <!-- Menu Điều Hướng Chính -->
      <nav class="header-nav-menu">
        <a href="/" class="nav-menu-link">Trang chủ</a>
        <a href="/tra-cuu" class="nav-menu-link">Tra cứu bảo hành</a>
        <a href="/san-pham-cua-toi" class="nav-menu-link">Sản phẩm của tôi</a>
        <a href="/gui-yeu-cau" class="nav-menu-link active">Gửi yêu cầu bảo hành</a>
        <a href="/#liveTrackerSection" class="nav-menu-link">Theo dõi bảo hành</a>
      </nav>

      <!-- Phía phải: Hotline & Đăng nhập -->
      <div class="header-right">
        <button class="icon-search-btn" title="Tìm kiếm nhanh" onclick="window.location.href='/tra-cuu'">
          <span>🔍</span>
        </button>
        <button class="btn-login" onclick="openLoginModal()">
          Đăng nhập
        </button>
      </div>
    </div>
  </header>

  <!-- ==============================================
       2. MAIN CONTENT (FORM GỬI YÊU CẦU BẢO HÀNH)
  ============================================== -->
  <main class="w-full py-8 bg-[#f8f9fa] min-h-[calc(100vh-16rem)]"
    style="background-image: linear-gradient(to right, rgba(0, 0, 0, 0.03) 1px, transparent 1px), linear-gradient(rgba(0, 0, 0, 0.03) 1px, transparent 1px); background-size: 32px 32px;">

    <!-- THÔNG BÁO FLASH (NẾU CÓ) -->
    <% if (typeof successMessage !=='undefined' && successMessage) { %>
      <div class="max-w-7xl mx-auto px-4 md:px-8 pt-4">
        <div
          class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl flex items-center justify-between text-sm">
          <span>✅ <%= successMessage %></span>
          <button onclick="this.parentElement.style.display='none'" class="text-emerald-800 text-lg">&times;</button>
        </div>
      </div>
      <% } %>

        <% if (typeof errorMessage !=='undefined' && errorMessage) { %>
          <div class="max-w-7xl mx-auto px-4 md:px-8 pt-4">
            <div
              class="bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 rounded-xl flex items-center justify-between text-sm">
              <span>⚠️ <%= errorMessage %></span>
              <button onclick="this.parentElement.style.display='none'" class="text-rose-800 text-lg">&times;</button>
            </div>
          </div>
          <% } %>

            <div class="flex flex-col w-full pb-10">
              <div class="max-w-7xl mx-auto px-4 md:px-8 pt-6">

                <!-- THẺ TIÊU ĐỀ TRÊN CÙNG & TIẾN TRÌNH 3 BƯỚC -->
                <div
                  class="relative bg-white rounded-xl border border-gray-200 shadow-sm p-6 md:p-8 mb-6 overflow-hidden">
                  <div
                    class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-[#ff6b00]/10 blur-3xl pointer-events-none">
                  </div>

                  <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                    <div>
                      <div
                        class="flex items-center gap-1.5 text-[#ff6b00] text-xs font-semibold uppercase tracking-wider mb-1">
                        <span class="material-symbols-outlined text-[16px]">build_circle</span>
                        <span>Yêu cầu dịch vụ kỹ thuật trực tuyến</span>
                      </div>
                      <h1 class="text-2xl md:text-3xl text-gray-900 tracking-tight font-extrabold">Tạo phiếu yêu cầu bảo
                        hành</h1>
                      <p class="text-sm text-gray-500 mt-1">Hệ thống kích hoạt quy trình chuẩn đoán sơ bộ và xếp lịch kỹ
                        thuật viên tiếp nhận thiết bị.</p>
                    </div>

                    <!-- Mã phiếu dự kiến & SLA -->
                    <div class="flex items-center gap-3 bg-gray-50 border border-gray-200 p-2 rounded-lg">
                      <div
                        class="flex items-center gap-1.5 px-2.5 py-1 bg-white rounded shadow-xs border border-gray-200">
                        <span class="w-2.5 h-2.5 rounded-full bg-[#ff6b00] animate-pulse"></span>
                        <span class="text-xs font-mono text-gray-800 font-semibold">SLA 24-48H</span>
                      </div>
                      <div class="text-gray-600 text-xs">
                        <span>Mã phiếu dự kiến: </span>
                        <span class="font-mono text-xs text-[#ff6b00] font-bold">WRQ-2024-OCT921</span>
                      </div>
                    </div>
                  </div>

                  <!-- Lưới 3 Bước Quy Trình -->
                  <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- Bước 1: Đã xác minh -->
                    <div
                      class="flex items-center gap-4 p-4 rounded-lg bg-gray-50 border border-gray-200 transition-all">
                      <div
                        class="w-9 h-9 rounded-full bg-[#171c23] text-white flex items-center justify-center text-sm shrink-0 shadow-sm">
                        <span class="material-symbols-outlined text-[20px] text-emerald-400">check</span>
                      </div>
                      <div class="min-w-0">
                        <span class="text-[11px] uppercase text-[#171c23] font-bold tracking-wider block">Bước 1 • Đã
                          xác minh</span>
                        <p class="text-sm text-gray-900 truncate font-semibold">Thiết bị bảo hành</p>
                      </div>
                    </div>

                    <!-- Bước 2: Hiện tại -->
                    <div
                      class="flex items-center gap-4 p-4 rounded-lg bg-[#ff6b00] text-white shadow-md border border-[#ff6b00]">
                      <div
                        class="w-9 h-9 rounded-full bg-white text-[#ff6b00] flex items-center justify-center text-sm font-bold shrink-0">
                        2</div>
                      <div class="min-w-0">
                        <span class="text-[11px] uppercase text-white/90 tracking-wider block font-semibold">Bước 2 •
                          Hiện tại</span>
                        <p class="text-sm text-white truncate font-bold">Chi tiết sự cố & Media</p>
                      </div>
                    </div>

                    <!-- Bước 3: Tiếp theo -->
                    <div
                      class="flex items-center gap-4 p-4 rounded-lg bg-gray-50 border border-gray-200 transition-all">
                      <div
                        class="w-9 h-9 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center text-sm shrink-0 font-bold">
                        3</div>
                      <div class="min-w-0">
                        <span class="text-[11px] uppercase text-gray-500 tracking-wider block font-semibold">Bước 3 •
                          Tiếp theo</span>
                        <p class="text-sm text-gray-600 truncate font-semibold">Phương thức nhận máy</p>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- FORM CHÍNH KẾT NỐI VÀO BACKEND EXPRESS & MONGODB -->
                <form action="/warranty/create" method="POST" id="warrantyRequestForm">

                  <!-- Lưới 2 cột (Trái 8 cột / Phải 4 cột) -->
                  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

                    <!-- CỘT TRÁI (8 CỘT): CÁC BƯỚC NHẬP LIỆU -->
                    <div class="lg:col-span-8 flex flex-col gap-6">

                      <!-- KHỐI 1: CHỌN SẢN PHẨM CẦN BẢO HÀNH -->
                      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 md:p-8">
                        <div class="flex items-center justify-between pb-4 mb-4 border-b border-gray-100">
                          <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-[#ff6b00] text-[24px]">devices</span>
                            <h2 class="text-lg text-gray-900 font-bold">1. Chọn sản phẩm cần bảo hành</h2>
                          </div>
                          <span
                            class="font-mono text-xs text-[#ff6b00] bg-[#ff6b00]/10 border border-[#ff6b00]/30 px-2.5 py-1 rounded font-semibold">DEVICE_ID:
                            9530-VN-XPS</span>
                        </div>

                        <div class="space-y-4">
                          <label class="block text-sm text-gray-900 font-semibold">Chọn từ danh mục sản phẩm đã đăng
                            ký</label>

                          <div class="relative">
                            <select id="productSelect" onchange="updateDeviceDisplay(this.value)"
                              class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-lg px-4 py-3 pr-10 appearance-none focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#ff6b00] shadow-xs transition-all cursor-pointer">
                              <option value="dlxps-99281" selected>Dell XPS 15 9530 (Serial: DLXPS-99281-VN) - Gói
                                ProSupport Plus</option>
                              <option value="mbp-14-3891">MacBook Pro 14 M2 Pro (Serial: C02G901KA92) - AppleCare+
                              </option>
                              <option value="lg-oled-42">LG UltraGear OLED 27GR95QE (Serial: LG9881273) - Tiêu chuẩn 24T
                              </option>
                            </select>
                            <span
                              class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">expand_more</span>
                          </div>

                          <!-- Thẻ chi tiết sản phẩm được chọn -->
                          <div
                            class="p-4 bg-gray-50 border border-gray-200 rounded-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                            <div class="flex items-center gap-4">
                              <div
                                class="w-14 h-14 rounded-lg bg-white border border-gray-200 p-1 shadow-xs shrink-0 flex items-center justify-center">
                                <img id="deviceThumbImg" class="w-full h-full object-contain rounded"
                                  alt="Dell XPS laptop"
                                  src="https://images.unsplash.com/photo-1593642632823-8f785ba67e45?auto=format&fit=crop&w=150&q=80">
                              </div>
                              <div>
                                <h3 id="deviceTitle" class="text-sm font-bold text-gray-900">Dell XPS 15 9530 (Core i7 /
                                  32GB / RTX 4060)</h3>
                                <p id="deviceSerial" class="font-mono text-xs text-gray-500 mt-0.5">S/N: DLXPS-99281-VN
                                  • Mua: 15/01/2024</p>
                              </div>
                            </div>

                            <div class="flex flex-col sm:items-end gap-1">
                              <span
                                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-semibold border border-emerald-200">
                                <span class="w-2 h-2 rounded-full bg-emerald-600"></span> Hợp lệ SLA • Còn hạn đến
                                15/01/2026
                              </span>
                              <span class="text-xs text-gray-500">Hỗ trợ thay thế linh kiện tại nhà miễn phí</span>
                            </div>
                          </div>

                          <!-- Hidden Inputs truyền dữ liệu vào backend -->
                          <input type="hidden" name="productName" id="hiddenProductName" value="Dell XPS 15 9530">
                          <input type="hidden" name="productSerial" id="hiddenProductSerial" value="DLXPS-99281-VN">
                          <input type="hidden" name="category" id="hiddenCategory" value="Laptop/Máy tính">
                          <input type="hidden" name="warrantyCode" value="WRQ-2024-OCT921">
                        </div>
                      </div>

                      <!-- KHỐI 2: PHÂN LOẠI SỰ CỐ & MÔ TẢ HIỆN TƯỢNG -->
                      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 md:p-8">
                        <div class="flex items-center gap-2 pb-4 mb-4 border-b border-gray-100">
                          <span class="material-symbols-outlined text-[#ff6b00] text-[24px]">troubleshoot</span>
                          <h2 class="text-lg text-gray-900 font-bold">2. Phân loại sự cố & Mô tả hiện tượng</h2>
                        </div>

                        <div class="space-y-6">
                          <div>
                            <label class="block text-sm text-gray-900 mb-2 font-semibold">Nhóm hiện tượng hư hỏng chính
                              (Có thể chọn nhiều mục)</label>

                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5" id="categoryButtonsContainer">
                              <button type="button" onclick="toggleIssueCategory(this, 'Màn hình / Hiển thị')"
                                class="issue-btn group flex items-center gap-2 p-2.5 rounded-lg bg-[#ff6b00]/10 text-[#a04100] border-2 border-[#ff6b00] font-semibold shadow-xs text-left transition-all">
                                <span class="material-symbols-outlined text-[20px] text-[#ff6b00]">monitor</span>
                                <span class="text-xs sm:text-sm">Màn hình / Hiển thị</span>
                              </button>

                              <button type="button" onclick="toggleIssueCategory(this, 'Nguồn / Sạc pin')"
                                class="issue-btn group flex items-center gap-2 p-2.5 rounded-lg bg-[#ff6b00]/10 text-[#a04100] border-2 border-[#ff6b00] font-semibold shadow-xs text-left transition-all">
                                <span class="material-symbols-outlined text-[20px] text-[#ff6b00]">battery_alert</span>
                                <span class="text-xs sm:text-sm">Nguồn / Sạc pin</span>
                              </button>

                              <button type="button" onclick="toggleIssueCategory(this, 'Bàn phím / Touchpad')"
                                class="issue-btn group flex items-center gap-2 p-2.5 rounded-lg bg-gray-50 hover:bg-gray-100 border border-gray-200 text-gray-800 text-left transition-all">
                                <span class="material-symbols-outlined text-[20px] text-gray-500">keyboard</span>
                                <span class="text-xs sm:text-sm">Bàn phím / Touchpad</span>
                              </button>

                              <button type="button" onclick="toggleIssueCategory(this, 'Loa / Âm thanh')"
                                class="issue-btn group flex items-center gap-2 p-2.5 rounded-lg bg-gray-50 hover:bg-gray-100 border border-gray-200 text-gray-800 text-left transition-all">
                                <span class="material-symbols-outlined text-[20px] text-gray-500">volume_up</span>
                                <span class="text-xs sm:text-sm">Loa / Âm thanh</span>
                              </button>

                              <button type="button" onclick="toggleIssueCategory(this, 'Treo máy / Quá nhiệt')"
                                class="issue-btn group flex items-center gap-2 p-2.5 rounded-lg bg-gray-50 hover:bg-gray-100 border border-gray-200 text-gray-800 text-left transition-all">
                                <span class="material-symbols-outlined text-[20px] text-gray-500">memory</span>
                                <span class="text-xs sm:text-sm">Treo máy / Quá nhiệt</span>
                              </button>

                              <button type="button" onclick="toggleIssueCategory(this, 'Lỗi phần cứng khác')"
                                class="issue-btn group flex items-center gap-2 p-2.5 rounded-lg bg-gray-50 hover:bg-gray-100 border border-gray-200 text-gray-800 text-left transition-all">
                                <span class="material-symbols-outlined text-[20px] text-gray-500">more_horiz</span>
                                <span class="text-xs sm:text-sm">Lỗi phần cứng khác</span>
                              </button>
                            </div>
                          </div>

                          <!-- Mô tả chi tiết triệu chứng máy -->
                          <div>
                            <div class="flex items-center justify-between mb-1.5">
                              <label class="text-sm text-gray-900 font-semibold">Mô tả chi tiết triệu chứng máy <span
                                  class="text-rose-500">*</span></label>
                              <span class="text-xs text-gray-400" id="charCount">114 / 1000 ký tự</span>
                            </div>
                            <textarea name="issueDescription" id="issueDescriptionText" rows="4" required
                              oninput="document.getElementById('charCount').innerText = this.value.length + ' / 1000 ký tự';"
                              class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-lg p-3.5 focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#ff6b00] shadow-xs leading-relaxed">Màn hình xuất hiện sọc tím ngang và đèn nguồn nhấp nháy cam khi cắm sạc. Khởi động lại máy vẫn không hết sọc, khi rút nguồn sạc ra thì máy tắt phụt hoàn toàn.</textarea>

                            <p class="text-xs text-gray-500 mt-2 flex items-center gap-1">
                              <span class="material-symbols-outlined text-[16px] text-[#ff6b00]">info</span>
                              Mô tả càng chi tiết sẽ giúp kỹ thuật viên chuẩn bị sẵn linh kiện thay thế trước khi tiếp
                              nhận máy.
                            </p>
                          </div>

                          <!-- Tải lên hình ảnh / Video thực tế lỗi -->
                          <div>
                            <label class="block text-sm text-gray-900 mb-1.5 font-semibold">Tải lên hình ảnh / Video
                              thực tế lỗi (Tối đa 50MB)</label>

                            <div
                              class="bg-[#ff6b00]/5 border-2 border-dashed border-[#ff6b00]/40 rounded-xl p-6 flex flex-col items-center justify-center text-center hover:bg-[#ff6b00]/10 transition-colors cursor-pointer group"
                              onclick="document.getElementById('fileUploadInput').click()">
                              <input type="file" id="fileUploadInput" class="hidden" multiple accept="image/*,video/*"
                                onchange="handleFileSelect(event)">
                              <div
                                class="w-12 h-12 rounded-full bg-[#ff6b00]/20 group-hover:scale-110 text-[#ff6b00] flex items-center justify-center mb-2 transition-transform shadow-xs">
                                <span
                                  class="material-symbols-outlined text-[28px] text-[#ff6b00] font-bold">cloud_upload</span>
                              </div>
                              <p class="text-sm text-gray-900 font-semibold">Kéo và thả tệp vào đây, hoặc <span
                                  class="text-[#ff6b00] underline font-bold">duyệt từ máy tính</span></p>
                              <p class="text-xs text-gray-500 mt-1">Chấp nhận JPG, PNG, MP4, MOV (Video tối đa 60 giây
                                để hỗ trợ chẩn đoán âm thanh hoặc chớp đèn)</p>
                            </div>

