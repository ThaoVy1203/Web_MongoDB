      overlay.classList.toggle('hidden');
    }

    // 2. Mở / Đóng Modal
    function openModal(id) {
      document.getElementById(id).classList.remove('hidden');
    }
    function closeModal(id) {
      document.getElementById(id).classList.add('hidden');
    }

    // 3. Mở Modal Thêm hồ sơ bảo hành
    function openAddWarrantyModal() {
      const randomNum = Math.floor(1000 + Math.random() * 9000);
      document.getElementById('newWbCode').value = `WB-2024-${randomNum}`;
      openModal('addWarrantyModal');
    }

    // 4. Mở Modal Batch Check
    function openBatchCheckModal() {
      openModal('batchCheckModal');
    }

    function executeBatchCheck() {
      const val = document.getElementById('batchInput').value.trim();
      if (!val) {
        alert('Vui lòng nhập ít nhất 1 mã Serial / IMEI để kiểm tra!');
        return;
      }
      closeModal('batchCheckModal');
      alert(`Đã kiểm tra đối soát 4 mã thiết bị: Tất cả 4/4 thiết bị đều có dữ liệu hợp lệ trên MongoDB Cluster!`);
    }

    // 5. Mở Modal Gia hạn
    function openRenewModal(code, device) {
      if (code) {
        document.getElementById('renewWbCode').value = code;
      }
      openModal('renewModal');
    }

    function handleRenewSubmit(e) {
      e.preventDefault();
      const code = document.getElementById('renewWbCode').value;
      const plan = document.getElementById('renewPlan').value;
      alert(`Gia hạn thành công hồ sơ [${code}] thêm ${plan} tháng! Hệ thống đã tự động kích hoạt bảo hành điện tử.`);
      closeModal('renewModal');
    }

    // 6. Xuất Excel & PDF
    function exportExcel() {
      alert('Đang trích xuất toàn bộ 18,450 hồ sơ bảo hành sang tệp Excel (.xlsx)...');
    }

    function exportPdf() {
      alert('Đang tổng hợp báo cáo tổng quan hồ sơ bảo hành sang tệp PDF...');
    }

    function printWarrantyCard(wbCode) {
      alert(`Đang mở giao diện in Phiếu / Thẻ bảo hành điện tử cho mã: ${wbCode}`);
    }

    function verifyWarranty(code, device, cust) {
      alert(`Xác thực thành công:\nHồ sơ: ${code}\nThiết bị: ${device}\nKhách hàng: ${cust}\nTrạng thái: HỢP LỆ VÀ CÒN HẠN BẢO HÀNH TRÊN MẠNG LƯỚI HÃNG.`);
    }

    // 7. Checkbox chọn tất cả
    function toggleSelectAll(master) {
      const checkboxes = document.querySelectorAll('.row-checkbox');
      checkboxes.forEach(cb => cb.checked = master.checked);
    }

    // 8. Chuyển đổi Tab Lọc
    let currentTab = 'all';
    function setWarrantyTab(btn, tab) {
      currentTab = tab;
      
      document.querySelectorAll('.warranty-tab').forEach(b => {
        b.className = 'warranty-tab px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 font-semibold shadow-2xs flex items-center gap-2 cursor-pointer transition-all flex-shrink-0';
      });

      btn.className = 'warranty-tab px-3.5 py-2 rounded-xl bg-[#ff6b00] text-white font-bold shadow-xs flex items-center gap-2 cursor-pointer transition-all flex-shrink-0';
      filterWarrantyTable();
    }

    // 9. Lọc bảng hồ sơ theo Tab & Ô tìm kiếm nhanh
    function filterWarrantyTable() {
      const search = (document.getElementById('quickSearchInput')?.value || '').toLowerCase().trim();
      const rows = document.querySelectorAll('#warrantyTable tbody tr.warranty-row');

      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        const rowStatus = row.getAttribute('data-status');

        const matchSearch = !search || text.includes(search);
        const matchTab = currentTab === 'all' || rowStatus === currentTab;

        if (matchSearch && matchTab) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    function resetWarrantyTable() {
      document.getElementById('quickSearchInput').value = '';
      currentTab = 'all';
      const allTabBtn = document.querySelector('.warranty-tab');
      if (allTabBtn) {
        setWarrantyTab(allTabBtn, 'all');
      }
      filterWarrantyTable();
      alert('Đã đồng bộ và làm mới bảng dữ liệu bảo hành!');
    }

    // 10. Lưu hồ sơ bảo hành mới vào bảng
    function handleSaveWarranty(e) {
      e.preventDefault();
      const code = document.getElementById('newWbCode').value;
      const period = document.getElementById('newPeriod').value;
      const cust = document.getElementById('newCustName').value.trim();
      const phone = document.getElementById('newCustPhone').value.trim();
      const prod = document.getElementById('newProdName').value.trim();
      const serial = document.getElementById('newSerial').value.trim();

      const tbody = document.querySelector('#warrantyTable tbody');
      const newTr = document.createElement('tr');
      newTr.className = 'hover:bg-slate-50/80 transition-colors warranty-row bg-emerald-50/20';
      newTr.setAttribute('data-status', 'active');

      const today = new Date();
      const dateStr = `${String(today.getDate()).padStart(2, '0')}/${String(today.getMonth()+1).padStart(2, '0')}/${today.getFullYear()}`;
      const expDate = new Date();
      expDate.setMonth(expDate.getMonth() + parseInt(period));
      const expStr = `${String(expDate.getDate()).padStart(2, '0')}/${String(expDate.getMonth()+1).padStart(2, '0')}/${expDate.getFullYear()}`;

      newTr.innerHTML = `
        <td class="py-4 pl-4 sm:pl-6 pr-2 text-center align-middle">
          <input type="checkbox" class="row-checkbox rounded border-slate-300 text-[#ff6b00] focus:ring-[#ff6b00]/30 cursor-pointer">
        </td>
        <td class="py-4 px-3 align-middle">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-[#fff4ec] border border-[#fed7aa] text-[#ff6b00] flex items-center justify-center flex-shrink-0">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
            </div>
            <div>
              <div class="font-mono font-bold text-[#ea580c] text-xs">
                ${code}
              </div>
              <div class="font-mono text-[10px] text-slate-400 mt-0.5">
                BSON#64fa99...
              </div>
            </div>
          </div>
        </td>
        <td class="py-4 px-4 align-middle">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center flex-shrink-0 font-bold text-xs">
              NEW
            </div>
            <div>
              <div class="font-bold text-slate-900 text-xs sm:text-sm">
                ${prod}
              </div>
              <div class="font-mono text-[11px] text-slate-500 mt-0.5">
                ${serial}
              </div>
            </div>
          </div>
        </td>
        <td class="py-4 px-4 align-middle">
          <div class="font-bold text-slate-900 text-xs">
            ${cust}
          </div>
          <div class="text-[11px] text-slate-500 flex items-center gap-1 mt-0.5">
            <span>📞</span> <span>${phone}</span>
          </div>
        </td>
        <td class="py-4 px-4 align-middle">
          <div class="text-[11px] text-slate-600">
            Mua: <span class="font-medium">${dateStr}</span>
          </div>
          <div class="text-[11px] text-[#ea580c] font-bold mt-0.5">
            Kích hoạt: Hôm nay
          </div>
        </td>
        <td class="py-4 px-4 align-middle">
          <div class="flex items-center justify-between text-xs font-bold text-slate-800 mb-1">
            <span>${expStr}</span>
            <span class="text-[10px] text-emerald-600 font-bold bg-emerald-50 px-1.5 py-0.2 rounded">Còn hạn</span>
          </div>
          <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
            <div class="bg-[#ff6b00] h-1.5 rounded-full" style="width: 100%"></div>
          </div>
        </td>
        <td class="py-4 pl-4 pr-6 text-center align-middle">
          <div class="flex items-center justify-center gap-2 text-slate-400">
            <button type="button" onclick="verifyWarranty('${code}', '${prod}', '${cust}')"
              class="hover:text-emerald-600 transition-colors p-1 cursor-pointer" title="Xác thực bảo hành">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <polyline points="9 12 11 14 15 10"></polyline>
              </svg>
            </button>
            <button type="button" onclick="openRenewModal('${code}', '${prod}')"
              class="hover:text-amber-600 transition-colors p-1 cursor-pointer" title="Gia hạn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
              </svg>
            </button>
            <button type="button" onclick="printWarrantyCard('${code}')"
              class="hover:text-slate-700 transition-colors p-1 cursor-pointer" title="In thẻ">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect x="6" y="14" width="12" height="8"></rect>
              </svg>
            </button>
          </div>
        </td>
      `;

      tbody.insertBefore(newTr, tbody.firstChild);
      closeModal('addWarrantyModal');
      document.getElementById('addWarrantyForm').reset();
      alert(`Đã kích hoạt hồ sơ bảo hành mới: [${code}] cho khách hàng ${cust} thành công!`);
      filterWarrantyTable();
    }
  </script>

</body>

</html>

