          <label class="font-bold text-slate-700 block mb-1">Mô tả hiện tượng lỗi ban đầu (*)</label>
          <textarea rows="3" placeholder="Mô tả chi tiết lỗi phần cứng hoặc phần mềm tiếp nhận..." class="w-full border border-slate-200 rounded-xl p-2.5 outline-none focus:border-[#ff6b00]"></textarea>
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-3 border-t border-slate-100">
        <button type="button" onclick="closeCreateTicketModal()" class="px-4 py-2 rounded-xl border border-slate-200 text-slate-600 font-bold text-xs hover:bg-slate-50 cursor-pointer">Hủy bỏ</button>
        <button type="button" onclick="submitNewTicket()" class="px-4 py-2 rounded-xl bg-[#ff6b00] text-white font-bold text-xs hover:bg-[#e05800] cursor-pointer">Khởi tạo Ticket</button>
      </div>
    </div>
  </div>

  <!-- Modal 2: Phân công KTV -->
  <div id="assignModal" class="fixed inset-0 z-50 modal-backdrop hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <h3 class="text-base font-black text-slate-900 uppercase">Phân công Kỹ thuật viên</h3>
        <button type="button" onclick="closeAssignModal()" class="text-slate-400 hover:text-slate-700 text-lg font-bold cursor-pointer">✕</button>
      </div>
      <div class="space-y-3 text-xs">
        <div>
          <label class="font-bold text-slate-700 block mb-1">Chọn kỹ thuật viên phụ trách:</label>
          <select class="w-full border border-slate-200 rounded-xl p-2.5 outline-none focus:border-[#ff6b00]">
            <option selected>Lê Minh Trí (KTV-08 - Chuyên phần cứng Dell/Apple)</option>
            <option>Nguyễn Văn Minh (Trưởng nhóm KTV)</option>
            <option>Vũ Quang Huy (KTV-04 - Chuyên bo mạch/IC)</option>
            <option>Phạm Hoàng Long (KTV-12 - Màn hình & Phụ kiện)</option>
          </select>
        </div>
        <div>
          <label class="font-bold text-slate-700 block mb-1">Hạn chót SLA xử lý:</label>
          <input type="datetime-local" class="w-full border border-slate-200 rounded-xl p-2.5 outline-none focus:border-[#ff6b00]" value="2024-10-19T17:00">
        </div>
        <div>
          <label class="font-bold text-slate-700 block mb-1">Ghi chú chỉ đạo kỹ thuật:</label>
          <textarea rows="2" class="w-full border border-slate-200 rounded-xl p-2.5 outline-none focus:border-[#ff6b00]" placeholder="Ghi chú riêng cho KTV phụ trách..."></textarea>
        </div>
      </div>
      <div class="flex justify-end gap-2 pt-3 border-t border-slate-100">
        <button type="button" onclick="closeAssignModal()" class="px-4 py-2 rounded-xl border border-slate-200 text-slate-600 font-bold text-xs hover:bg-slate-50 cursor-pointer">Đóng</button>
        <button type="button" onclick="alert('Đã cập nhật phân công KTV Lê Minh Trí phụ trách phiếu!'); closeAssignModal();" class="px-4 py-2 rounded-xl bg-[#ff6b00] text-white font-bold text-xs hover:bg-[#e05800] cursor-pointer">Xác nhận phân công</button>
      </div>
    </div>
  </div>

  <!-- Modal 3: Cập nhật trạng thái phiếu -->
  <div id="statusModal" class="fixed inset-0 z-50 modal-backdrop hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <h3 class="text-base font-black text-slate-900 uppercase">Cập nhật trạng thái phiếu</h3>
        <button type="button" onclick="closeStatusModal()" class="text-slate-400 hover:text-slate-700 text-lg font-bold cursor-pointer">✕</button>
      </div>
      <div class="space-y-3 text-xs">
        <div>
          <label class="font-bold text-slate-700 block mb-1">Trạng thái xử lý:</label>
          <select class="w-full border border-slate-200 rounded-xl p-2.5 outline-none focus:border-[#ff6b00]">
            <option>Tiếp nhận</option>
            <option>Đang kiểm tra & đo đạc</option>
            <option selected>Chờ duyệt xuất kho linh kiện</option>
            <option>Đang thay thế sửa chữa</option>
            <option>Chờ test kiểm định chất lượng (QC)</option>
            <option>Đã sửa xong - Sẵn sàng trả máy</option>
            <option>Đã trả khách hoàn tất</option>
          </select>
        </div>
        <div>
          <label class="font-bold text-slate-700 block mb-1">Ghi chú cập nhật hệ thống:</label>
          <textarea rows="3" class="w-full border border-slate-200 rounded-xl p-2.5 outline-none focus:border-[#ff6b00]" placeholder="Ghi chú trạng thái mới..."></textarea>
        </div>
      </div>
      <div class="flex justify-end gap-2 pt-3 border-t border-slate-100">
        <button type="button" onclick="closeStatusModal()" class="px-4 py-2 rounded-xl border border-slate-200 text-slate-600 font-bold text-xs hover:bg-slate-50 cursor-pointer">Hủy</button>
        <button type="button" onclick="alert('Đã cập nhật tiến độ phiếu bảo hành thành công!'); closeStatusModal();" class="px-4 py-2 rounded-xl bg-[#ff6b00] text-white font-bold text-xs hover:bg-[#e05800] cursor-pointer">Lưu cập nhật</button>
      </div>
    </div>
  </div>

  <!-- Modal 4: Xem Media / Đính kèm -->
  <div id="mediaModal" class="fixed inset-0 z-50 modal-backdrop hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 text-white rounded-2xl max-w-2xl w-full p-5 shadow-2xl border border-slate-700 space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-700">
        <h3 class="text-sm font-black uppercase text-amber-400" id="mediaTitle">Tài liệu đính kèm</h3>
        <button type="button" onclick="closeMediaModal()" class="text-slate-400 hover:text-white text-lg font-bold cursor-pointer">✕</button>
      </div>
      <div class="h-64 sm:h-80 bg-black rounded-xl overflow-hidden flex items-center justify-center border border-slate-800" id="mediaContent">
        <!-- Render ảnh hoặc video động -->
      </div>
      <div class="flex justify-end">
        <button type="button" onclick="closeMediaModal()" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs cursor-pointer">Đóng xem trước</button>
      </div>
    </div>
  </div>

  <!-- ==============================================
       JAVASCRIPT TƯƠNG TÁC
  ============================================== -->
  <script>
    // 1. Toggle Sidebar Mobile
    function toggleSidebar() {
      const sidebar = document.getElementById('adminSidebar');
      const overlay = document.getElementById('sidebarOverlay');
      sidebar.classList.toggle('-translate-x-full');
      overlay.classList.toggle('hidden');
    }

    // 2. Chuyển đổi chọn Ticket trong hàng đợi
    const ticketData = {
      'TKT-2024-0419': {
        code: 'Phiếu yêu cầu #TKT-2024-0419',
        customer: 'Trần Hoàng Nam',
        vip: 'Khách hàng Cá nhân VIP 2',
        device: 'Dell XPS 15 9530 (OLED 3.5K)',
        serial: 'DLXPS-99281-VN'
      },
      'TKT-2024-0418': {
        code: 'Phiếu yêu cầu #TKT-2024-0418',
        customer: 'Phan Kim Đức',
        vip: 'Khách hàng Thân thiết',
        device: 'Màn hình Asus ProArt PA278CV',
        serial: 'SN-ASUS-27PA-99'
      },
      'TKT-2024-0415': {
        code: 'Phiếu yêu cầu #TKT-2024-0415',
        customer: 'Lê Thị Mai Khanh',
        vip: 'Khách hàng Cá nhân',
        device: 'Bàn phím cơ Keychron Q1 Pro',
        serial: 'SN-KC-Q1P-8812'
      },
      'TKT-2024-0413': {
        code: 'Phiếu yêu cầu #TKT-2024-0413',
        customer: 'Vũ Đình Trọng',
        vip: 'Khách hàng Doanh nghiệp VIP',
        device: 'Card VGA RTX 4080 ROG Strix',
        serial: 'SN-ROG-4080-X9'
      },
      'TKT-2024-0402': {
        code: 'Phiếu yêu cầu #TKT-2024-0402',
        customer: 'Đặng Gia Huy',
        vip: 'Khách hàng Cá nhân',
        device: 'Tai nghe Sony WH-1000XM5',
        serial: 'SN-SONY-WH5-331'
      }
    };

    function selectTicket(ticketId) {
      document.querySelectorAll('.ticket-card').forEach(el => {
        el.classList.remove('border-[#ff6b00]', 'bg-orange-50/40', 'border-2');
        el.classList.add('border-slate-200', 'bg-white');
      });

      const selected = document.getElementById('card-' + ticketId);
      if (selected) {
        selected.classList.remove('border-slate-200', 'bg-white');
        selected.classList.add('border-[#ff6b00]', 'bg-orange-50/40', 'border-2');
      }

      const data = ticketData[ticketId];
      if (data) {
        document.getElementById('detailTicketCode').innerText = data.code;
      }
    }

    // 3. Lọc tab hàng đợi
    function filterQueue(status) {
      document.querySelectorAll('.queue-tab').forEach(btn => {
        btn.classList.remove('active', 'bg-[#ff6b00]', 'text-white', 'shadow-xs');
        btn.classList.add('bg-slate-100', 'text-slate-600');
      });
      event.target.classList.add('active', 'bg-[#ff6b00]', 'text-white', 'shadow-xs');
      event.target.classList.remove('bg-slate-100', 'text-slate-600');
    }

    // 4. Tìm kiếm nhanh trong hàng đợi
    function searchQueue(query) {
      const q = query.toLowerCase().trim();
      document.querySelectorAll('.ticket-card').forEach(card => {
        const text = card.innerText.toLowerCase();
        if (text.includes(q)) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // 5. Chuyển đổi Tabs phản hồi khách / ghi chú nội bộ
    function switchFeedbackTab(tab) {
      const tabCustomer = document.getElementById('feedbackTabCustomer');
      const tabInternal = document.getElementById('feedbackTabInternal');
      const panelCustomer = document.getElementById('feedbackPanelCustomer');
      const panelInternal = document.getElementById('feedbackPanelInternal');

      if (tab === 'customer') {
        tabCustomer.classList.add('bg-[#ff6b00]', 'text-white');
        tabCustomer.classList.remove('bg-slate-100', 'text-slate-600');
        tabInternal.classList.remove('bg-[#ff6b00]', 'text-white');
        tabInternal.classList.add('bg-slate-100', 'text-slate-600');
        panelCustomer.classList.remove('hidden');
        panelInternal.classList.add('hidden');
      } else {
        tabInternal.classList.add('bg-[#ff6b00]', 'text-white');
        tabInternal.classList.remove('bg-slate-100', 'text-slate-600');
        tabCustomer.classList.remove('bg-[#ff6b00]', 'text-white');
        tabCustomer.classList.add('bg-slate-100', 'text-slate-600');
        panelInternal.classList.remove('hidden');
        panelCustomer.classList.add('hidden');
      }
    }

    // 6. Gửi thông báo SMS / Zalo
    function sendCustomerNotification() {
      const msg = document.getElementById('feedbackMessageInput').value;
      if (!msg.trim()) {
        alert('Vui lòng nhập nội dung thông báo gửi khách hàng!');
        return;
      }
      alert('Đã gửi thông báo thành công qua Zalo ZNS và SMS Brandname tới số điện thoại 0912.345.678 của khách hàng Trần Hoàng Nam!');
    }

    // 7. Xuất kho linh kiện
    function exportComponent(code) {
      alert('Đã gửi lệnh xuất kho linh kiện [' + code + '] tới Thủ kho Tân Bình. Phiếu xuất kho đã được duyệt tự động!');
    }

    // 8. In biên nhận tiếp nhận bảo hành
    function printReceipt() {
      alert('Đang tạo bản in Biên nhận bảo hành chính thức cho phiếu #TKT-2024-0419...');
      window.print();
    }

    // 9. Từ chối bảo hành
    function rejectTicket() {
      const reason = prompt('Nhập lý do từ chối bảo hành (ví dụ: Vi phạm tem niêm phong, tác động vật lý rơi vỡ):');
      if (reason) {
        alert('Đã lập biên bản từ chối bảo hành với lý do: ' + reason);
      }
    }

    // 10. Làm mới hàng đợi
    function refreshTicketQueue() {
      alert('Đã đồng bộ dữ liệu mới nhất từ CSDL MongoDB & Hệ thống WareX lúc ' + new Date().toLocaleTimeString());
    }

    // 11. Xuất Excel danh sách RMA
    function exportTicketsExcel() {
      alert('Đang trích xuất 28 hồ sơ yêu cầu bảo hành đang mở sang tệp Excel (.xlsx)...');
    }

    // 12. Quản lý Modal Tiếp nhận phiếu
    function openCreateTicketModal() {
      document.getElementById('createTicketModal').classList.remove('hidden');
    }
    function closeCreateTicketModal() {
      document.getElementById('createTicketModal').classList.add('hidden');
    }
    function submitNewTicket() {
      alert('Đã khởi tạo phiếu yêu cầu bảo hành RMA mới thành công!');
      closeCreateTicketModal();
    }

    // 13. Modal Phân công KTV
    function openAssignModal() {
      document.getElementById('assignModal').classList.remove('hidden');
    }
    function closeAssignModal() {
      document.getElementById('assignModal').classList.add('hidden');
    }

    // 14. Modal Cập nhật trạng thái
    function openUpdateStatusModal() {
      document.getElementById('statusModal').classList.remove('hidden');
    }
    function closeStatusModal() {
      document.getElementById('statusModal').classList.add('hidden');
    }

    // 15. Modal Xem Media
    function viewMedia(filename, type) {
      const modal = document.getElementById('mediaModal');
      const title = document.getElementById('mediaTitle');
      const content = document.getElementById('mediaContent');

      title.innerText = 'Xem trước đính kèm: ' + filename;
      if (type === 'image') {
        content.innerHTML = `
          <div class="p-6 text-center space-y-3">
            <div class="h-44 w-72 mx-auto bg-purple-950/60 rounded-xl border border-purple-500/40 flex flex-col justify-around p-3">
              <div class="h-1 bg-purple-400 w-full animate-pulse"></div>
              <div class="h-2 bg-purple-300 w-full"></div>
              <div class="h-1.5 bg-fuchsia-400 w-full"></div>
            </div>
            <p class="text-xs text-slate-300 font-mono">Hình ảnh hiển thị lỗi sọc tím màn hình OLED Dell XPS 15</p>
          </div>
        `;
      } else {
        content.innerHTML = `
          <div class="p-6 text-center space-y-3">
            <div class="w-16 h-16 rounded-full bg-[#ff6b00] text-white mx-auto flex items-center justify-center animate-pulse">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </div>
            <p class="text-xs text-slate-300 font-mono">Đang phát clip ghi nhận đèn nguồn nhấp nháy 8 cam - 2 trắng</p>
          </div>
        `;
      }
      modal.classList.remove('hidden');
    }
    function closeMediaModal() {
      document.getElementById('mediaModal').classList.add('hidden');
    }

    function openFilterModal() {
      alert('Bộ lọc nâng cao: Lọc theo thời hạn SLA, nhóm kỹ thuật viên phụ trách, phân loại khách hàng VIP.');
    }
  </script>

</body>

