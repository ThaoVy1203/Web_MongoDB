<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>Báo Cáo & Thống Kê Hoạt Động Bảo Hành - EXED OPS ADMIN</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Hanken+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary": "#ff6b00",
            "primary-dark": "#e05800",
            "primary-light": "#fff7ed",
            "topbar-dark": "#2a1212",
            "sidebar-active-bg": "#fbeee6",
            "sidebar-active-text": "#8B2500"
          },
          fontFamily: {
            "sans": ["Plus Jakarta Sans", "Hanken Grotesk", "sans-serif"],
            "mono": ["JetBrains Mono", "monospace"]
          }
        }
      }
    }
  </script>

  <style>
    @layer base {
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
    }

    /* Tùy chỉnh thanh cuộn mảnh */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    .modal-backdrop {
      background-color: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(4px);
    }
  </style>
</head>

<body class="bg-[#f8fafc] text-[#111315] antialiased min-h-screen flex flex-col selection:bg-[#ff6b00]/20 selection:text-[#ff6b00]">

  <!-- ==============================================
       1. TOP HEADER TOÀN MÀN HÌNH (DARK BURGUNDY #2a1212)
  ============================================== -->
  <header class="h-20 bg-[#2a1212] text-white sticky top-0 z-50 px-4 sm:px-6 flex items-center justify-between border-b border-black/30 shadow-xs">
    
    <!-- Phía trái: Logo11 nhỏ gọn + Badge ADMIN -->
    <div class="flex items-center gap-3">
      <!-- Nút mở drawer trên mobile -->
      <button type="button" onclick="toggleSidebar()" class="lg:hidden text-white/80 hover:text-white p-1.5 mr-1 cursor-pointer">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <a href="/admin" class="flex items-center group py-1">
        <img src="/images/logo11.png" alt="WarrantyOps Logo" class="h-10 sm:h-11 object-contain transition-transform group-hover:scale-105"
          onerror="this.onerror=null; this.src='/images/logo1.png';">
      </a>

      <span class="bg-black/40 text-white/90 text-[10px] font-bold px-2.5 py-0.5 rounded-full border border-white/20 tracking-wider uppercase ml-1 shadow-2xs">
        ADMIN
      </span>
    </div>

    <!-- Phía phải: Chuông thông báo + Profile Admin01 -->
    <div class="flex items-center gap-4 sm:gap-5">
      
      <!-- Chuông thông báo có chấm cam -->
      <button type="button" onclick="alert('Đã tạo thành công Báo cáo định kỳ Tháng 10/2024! Tỷ lệ tuân thủ SLA đạt 98.5%.')"
        class="relative text-white/80 hover:text-white transition-colors p-1" title="Thông báo hệ thống">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <span class="absolute top-0.5 right-0.5 w-2 h-2 rounded-full bg-[#ff6b00]"></span>
      </button>

      <!-- Profile admin01 -->
      <div class="flex items-center gap-2 text-white/90 text-xs font-bold cursor-pointer hover:text-white transition-colors">
        <div class="w-7 h-7 rounded-full bg-[#ff6b00]/25 text-[#ff6b00] border border-[#ff6b00]/40 flex items-center justify-center">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <span>admin01</span>
      </div>

    </div>

  </header>

  <!-- ==============================================
       CONTAINER DƯỚI TOPBAR: SIDEBAR + MAIN CONTENT
  ============================================== -->
  <div class="flex-1 flex min-h-[calc(100vh-5rem)] relative">

    <!-- ==============================================
         2. SIDEBAR TRÁI (WHITE THEME / ĐỒNG BỘ DASHBOARD)
    ============================================== -->
    <aside id="adminSidebar"
      class="w-60 lg:w-64 bg-white border-r border-slate-200/90 flex flex-col justify-between fixed lg:sticky top-20 bottom-0 left-0 z-40 transition-transform duration-300 -translate-x-full lg:translate-x-0 h-[calc(100vh-5rem)] overflow-y-auto">
      
      <!-- Danh sách menu điều hướng -->
      <div class="p-3.5 sm:p-4">
        
        <nav class="space-y-1">
          
          <!-- 1. Tổng quan (Dashboard) -->
          <a href="/admin"
            class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-50 font-medium text-xs transition-all">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
            </svg>
            <span>Tổng quan (Dashboard)</span>
          </a>

          <!-- 2. Quản lý khách hàng (Badge 1.4k) -->
          <a href="/admin/khach-hang"
            class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-50 font-medium text-xs transition-all">
            <div class="flex items-center gap-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
              <span>Quản lý khách hàng</span>
            </div>
            <span class="bg-slate-100 text-slate-500 font-semibold text-[10px] px-1.5 py-0.5 rounded">1.4k</span>
          </a>

          <!-- 3. Quản lý sản phẩm -->
          <a href="/admin/san-pham"
            class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-50 font-medium text-xs transition-all">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
            <span>Quản lý sản phẩm</span>
          </a>

          <!-- 4. Hồ sơ bảo hành -->
          <a href="/admin/ho-so-bao-hanh"
            class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-50 font-medium text-xs transition-all">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
            <span>Hồ sơ bảo hành</span>
          </a>

          <!-- 5. Yêu cầu & Xử lý phiếu (Chấm cam) -->
          <a href="/admin/yeu-cau-bao-hanh"
            class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-50 font-medium text-xs transition-all">
            <div class="flex items-center gap-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                <line x1="9" y1="9" x2="15" y2="9"></line>
                <line x1="9" y1="13" x2="13" y2="13"></line>
              </svg>
              <span>Yêu cầu & Xử lý phiếu</span>
            </div>
            <span class="w-2 h-2 rounded-full bg-[#ff6b00] ring-4 ring-[#ff6b00]/20 animate-pulse"></span>
          </a>

          <!-- 6. Thống kê & Báo cáo - ACTIVE (Nền cam nhạt #fbeee6, Chữ nâu đỏ #8B2500) -->
          <a href="/admin/thong-ke"
            class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-[#fbeee6] text-[#8B2500] font-extrabold text-xs transition-all shadow-2xs">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
              <polyline points="17 6 23 6 23 12"></polyline>
            </svg>
            <span>Thống kê & Báo cáo</span>
          </a>

        </nav>

      </div>

      <!-- Khối chân Sidebar: Trạng thái MongoDB & Ngôn ngữ -->
      <div class="p-4 border-t border-slate-100 bg-slate-50/50 space-y-2">
        <div class="flex items-center justify-between text-[11px] text-slate-500 font-medium">
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="font-mono text-slate-600">MongoDB v7.0 • Online</span>
          </div>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400">
            <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
            <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
            <line x1="6" y1="6" x2="6.01" y2="6"></line>
            <line x1="6" y1="18" x2="6.01" y2="18"></line>
          </svg>
        </div>

        <div class="flex items-center justify-between text-[11px] text-slate-400 pt-1 border-t border-slate-200/60">
          <span class="hover:text-slate-600 cursor-pointer">⚙ Cấu hình</span>
          <span class="font-bold text-slate-500 hover:text-slate-700 cursor-pointer">🌐 VN</span>
        </div>
      </div>

    </aside>

    <!-- Overlay đóng sidebar trên mobile -->
    <div id="sidebarOverlay" onclick="toggleSidebar()"
      class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-30 hidden lg:hidden"></div>

    <!-- ==============================================
         3. KHÔNG GIAN NỘI DUNG CHÍNH (THỐNG KÊ & BÁO CÁO)
    ============================================== -->
    <main class="flex-1 p-4 sm:p-6 lg:p-7 space-y-5 min-w-0">

      <!-- ==============================================
           A. HEADER TRANG: BỐ CỤC & KÍCH THƯỚC GIỐNG TRANG QUẢN LÝ KHÁCH HÀNG
           (Tiêu đề in hoa bên trái, 3 nút hành động bên phải cùng hàng ngang)
      ============================================== -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        
        <!-- Tiêu đề trang in hoa toàn bộ & đồng bộ màu header #2a1212 -->
        <div>
          <h1 class="text-2xl sm:text-[28px] font-black text-[#2a1212] tracking-tight uppercase">
            BÁO CÁO & THỐNG KÊ HOẠT ĐỘNG BẢO HÀNH
          </h1>
        </div>

        <!-- Cụm 3 nút hành động bên phải: Nằm ngang hàng nhau -->
        <div class="flex items-center gap-2 sm:gap-2.5 flex-nowrap overflow-x-auto pb-1 sm:pb-0">
          
          <!-- Nút 1: Lên lịch gửi Email tự động -->
          <button type="button" onclick="openScheduleEmailModal()"
            class="bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 text-xs font-bold px-3.5 py-2.5 rounded-xl shadow-xs flex items-center gap-2 cursor-pointer transition-all active:scale-95 whitespace-nowrap flex-shrink-0">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>Lên lịch gửi Email tự động</span>
          </button>

          <!-- Nút 2: Báo cáo PDF Đồ họa -->
          <button type="button" onclick="exportPdfAnalytics()"
            class="bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 text-xs font-bold px-3.5 py-2.5 rounded-xl shadow-xs flex items-center gap-2 cursor-pointer transition-all active:scale-95 whitespace-nowrap flex-shrink-0">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="12" y1="18" x2="12" y2="12"></line>
              <line x1="9" y1="15" x2="15" y2="15"></line>
            </svg>
            <span>Báo cáo PDF Đồ họa</span>
          </button>

          <!-- Nút 3: + Xuất CSV / Excel (Cam #ff6b00) - Luôn nằm ngang hàng -->
          <button type="button" onclick="exportExcelAnalytics()"
            class="bg-[#ff6b00] hover:bg-[#e05800] text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-xs flex items-center gap-2 cursor-pointer transition-all active:scale-95 whitespace-nowrap flex-shrink-0">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>+ Xuất CSV / Excel</span>
          </button>

        </div>

      </div>

      <!-- ==============================================
           B. KHUNG BỘ LỌC ĐIỀU KIỆN (FILTER BAR THEO HÌNH MẪU)
      ============================================== -->
      <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/80 shadow-xs flex flex-col xl:flex-row xl:items-center justify-between gap-4">
        
        <!-- Các trường lọc bên trái -->
        <div class="flex items-center flex-wrap gap-3 text-xs">
          
          <!-- Lọc khoảng thời gian -->
          <div class="flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-slate-700">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span class="font-bold text-slate-500 uppercase text-[10px]">Thời gian:</span>
            <span class="font-bold text-slate-800">01/01/2024 — 31/10/2024</span>
          </div>

          <!-- Lọc Chi nhánh -->
          <div class="flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-slate-700">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span class="font-bold text-slate-500 uppercase text-[10px]">Chi nhánh:</span>
            <select class="bg-transparent border-none p-0 text-xs font-bold text-slate-800 outline-none focus:ring-0 cursor-pointer">
              <option>Toàn quốc (Hà Nội, TP.HCM, Đà Nẵng)</option>
              <option>TTBH Hà Nội (Đống Đa)</option>
              <option>TTBH TP. Hồ Chí Minh (Tân Bình)</option>
              <option>TTBH Đà Nẵng (Hải Châu)</option>
            </select>
          </div>

          <!-- Lọc Dòng sản phẩm -->
          <div class="flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-slate-700">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="2" y1="20" x2="22" y2="20"></line>
            </svg>
            <span class="font-bold text-slate-500 uppercase text-[10px]">Dòng SP:</span>
            <select class="bg-transparent border-none p-0 text-xs font-bold text-slate-800 outline-none focus:ring-0 cursor-pointer">
              <option>Tất cả danh mục sản phẩm</option>
              <option>Laptop & Máy trạm</option>
              <option>Điện thoại & Tablet</option>
              <option>Màn hình đồ họa</option>
              <option>Linh kiện VGA & CPU</option>
              <option>Thiết bị mạng & Âm thanh</option>
            </select>
          </div>

        </div>

        <!-- Các nút lọc nhanh bên phải: Hôm nay, Quý này, T10 tháng 2024 -->
        <div class="flex items-center gap-1.5 text-xs font-bold select-none">
          <button type="button" onclick="setQuickDate('today')"
            class="px-3 py-1.5 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors cursor-pointer">
            Hôm nay
          </button>
          <button type="button" onclick="setQuickDate('quarter')"
            class="px-3 py-1.5 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors cursor-pointer">
            Quý này
          </button>
          <button type="button" onclick="setQuickDate('oct')"
            class="px-3.5 py-1.5 rounded-xl bg-[#ff6b00] text-white shadow-xs cursor-pointer">
            T10 tháng 2024
          </button>
          <button type="button" onclick="alert('Đã đồng bộ và làm mới số liệu báo cáo!')"
            class="p-2 rounded-xl text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer" title="Làm mới">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
            </svg>
          </button>
        </div>

      </div>

      <!-- ==============================================
           C. 4 THẺ KPI TỔNG QUAN (KPI CARDS THEO HÌNH MẪU)
      ============================================== -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Card 1: Tổng tiếp nhận -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">TỔNG TIẾP NHẬN</span>
            <div class="w-8 h-8 rounded-xl bg-orange-50 text-[#ff6b00] flex items-center justify-center">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
            </div>
          </div>
          <div>
            <div class="flex items-baseline gap-2">
              <span class="text-3xl font-black text-slate-900 tracking-tight">1,428</span>
              <span class="text-xs text-slate-500 font-bold">phiếu</span>
            </div>
          </div>
          <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[11px]">
            <span class="text-emerald-600 font-bold bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200">
              +14.2% so với 2023
            </span>
            <span class="text-slate-400 font-medium">SLA TB: 18h</span>
