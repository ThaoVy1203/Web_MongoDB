<%
  const activeTab = typeof activePage !== 'undefined' ? activePage : '';
%>
<!-- ==============================================
     HEADER DÙNG CHUNG TOÀN HỆ THỐNG WARRANTY OPS
============================================== -->
<header class="site-header">
  <div class="container header-wrap">

    <!-- Logo thương hiệu góc trên bên trái -->
    <a href="/" class="brand-area">
      <img src="/images/logo1.png" alt="WarrantyOps Logo" class="brand-logo-img" style="height: 48px; width: auto; object-fit: contain;"
        onerror="this.onerror=null; this.src='/images/logo.png';">
    </a>

    <!-- Menu điều hướng chính -->
    <nav class="header-nav-menu">
      <a href="/" class="nav-menu-link <%= activeTab === 'home' || activeTab === 'trang-chu' ? 'active' : '' %>">Trang chủ</a>
      <a href="/tra-cuu" class="nav-menu-link <%= activeTab === 'tra-cuu' ? 'active' : '' %>">Tra cứu bảo hành</a>
      <a href="/san-pham-cua-toi" class="nav-menu-link <%= activeTab === 'san-pham' || activeTab === 'san-pham-cua-toi' ? 'active' : '' %>">Sản phẩm của tôi</a>
      <a href="/gui-yeu-cau" class="nav-menu-link <%= activeTab === 'gui-yeu-cau' ? 'active' : '' %>">Gửi yêu cầu bảo hành</a>
      <a href="/theo-doi" class="nav-menu-link <%= activeTab === 'theo-doi' ? 'active' : '' %>">Theo dõi bảo hành</a>
    </nav>

    <!-- Phía phải: Hotline, Tìm kiếm & Đăng nhập -->
    <div class="header-right">
      <div class="header-hotline-badge hidden sm:flex items-center gap-1.5 text-xs text-slate-600 font-semibold mr-1" style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #475569; font-weight: 600; margin-right: 6px;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#ff6b00" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>Hotline: <strong style="color: #0f172a;">1900 6868</strong></span>
      </div>
      <button class="icon-search-btn" title="Tìm kiếm tra cứu nhanh" onclick="window.location.href='/tra-cuu'">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
      <button class="btn-login" onclick="openLoginModal()">
        Đăng nhập
      </button>
    </div>

  </div>
</header>

<script>
  if (typeof openLoginModal !== 'function') {
    function openLoginModal() {
      window.location.href = '/dang-nhap';
    }
  }
</script>

