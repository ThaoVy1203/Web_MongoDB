<%
  const activeTab = typeof activePage !== 'undefined' ? activePage : '';
  const user = typeof currentUser !== 'undefined' ? currentUser : null;
%>
<header class="site-header">
  <div class="container header-wrap">

    <a href="/" class="brand-area">
      <img src="/images/logo1.png" alt="WarrantyOps Logo" class="brand-logo-img" style="height: 46px; width: auto; object-fit: contain;"
        onerror="this.onerror=null; this.src='/images/logo.png';">
    </a>

    <nav class="header-nav-menu">
      <a href="/" class="nav-menu-link <%= activeTab === 'home' || activeTab === 'trang-chu' ? 'active' : '' %>">Trang chủ</a>
      <a href="/tra-cuu" class="nav-menu-link <%= activeTab === 'tra-cuu' ? 'active' : '' %>">Tra cứu bảo hành</a>
      <a href="/san-pham-cua-toi" class="nav-menu-link <%= activeTab === 'san-pham' || activeTab === 'san-pham-cua-toi' ? 'active' : '' %>">Sản phẩm của tôi</a>
      <a href="/gui-yeu-cau" class="nav-menu-link <%= activeTab === 'gui-yeu-cau' ? 'active' : '' %>">Gửi yêu cầu</a>
      <a href="/theo-doi" class="nav-menu-link <%= activeTab === 'theo-doi' ? 'active' : '' %>">Theo dõi tiến độ</a>
    </nav>

    <div class="header-right">
      <button class="icon-search-btn" title="Tra cứu nhanh Serial / Mã phiếu" onclick="window.location.href='/tra-cuu'">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <% if (user) { %>
        <div style="display: flex; align-items: center; gap: 8px;">
          <% if (user.role === 'admin') { %>
            <a href="/admin" style="font-size: 0.78rem; font-weight: 700; color: #ea580c; background: #fff7ed; border: 1px solid #fed7aa; padding: 0.38rem 0.75rem; border-radius: 999px; text-decoration: none;">
              Admin
            </a>
          <% } %>
          <a href="/san-pham-cua-toi" style="font-size: 0.82rem; font-weight: 700; color: #0f172a; background: #f1f5f9; padding: 0.42rem 0.85rem; border-radius: 999px; text-decoration: none;">
            <%= user.fullname %>
          </a>
          <a href="/dang-xuat" title="Đăng xuất" style="font-size: 0.78rem; font-weight: 600; color: #64748b; padding: 0.4rem 0.55rem; text-decoration: none;">
            Thoát
          </a>
        </div>
      <% } else { %>
        <a href="/dang-nhap" class="btn-login" style="text-decoration: none;">
          Đăng nhập
        </a>
      <% } %>
    </div>

  </div>
</header>
