  <script>
    // 1. Điều khiển Sidebar Mobile
    function toggleSidebar() {
      const sidebar = document.getElementById('adminSidebar');
      const overlay = document.getElementById('sidebarOverlay');
      sidebar.classList.toggle('-translate-x-full');
      overlay.classList.toggle('hidden');
    }

    // 2. Mở / Đóng Modal
    function openModal(id) {
      document.getElementById(id).classList.remove('hidden');
    }
    function closeModal(id) {
      document.getElementById(id).classList.add('hidden');
    }

    // 3. Mở Modal Chỉnh sửa hồ sơ
    function openEditProfileModal() {
      openModal('editProfileModal');
    }

    function handleSaveProfile(e) {
      e.preventDefault();
      const name = document.getElementById('editName').value;
      const phone = document.getElementById('editPhone').value;
      const email = document.getElementById('editEmail').value;
      const address = document.getElementById('editAddress').value;

      document.getElementById('profileName').innerText = name;
      document.getElementById('profilePhone').innerText = phone;
      document.getElementById('profileEmail').innerText = email;
      document.getElementById('profileAddress').innerText = address;

      closeModal('editProfileModal');
      alert(`Đã cập nhật thông tin hồ sơ cho khách hàng: ${name} thành công!`);
    }

    // 4. Mở Modal Tạo phiếu BH
    function openCreateTicketModal(custName, custPhone, deviceName, serial) {
      document.getElementById('ticketCustName').value = `${custName} - ${custPhone}`;
      if (deviceName && serial) {
        const select = document.getElementById('ticketDeviceSelect');
        select.value = `${deviceName} - ${serial}`;
      }
      openModal('createTicketModal');
    }

    function handleQuickTicket(e) {
      e.preventDefault();
      const issue = document.getElementById('ticketIssue').value;
      alert(`Tạo phiếu yêu cầu bảo hành thành công!\nNội dung lỗi: ${issue}\nPhiếu đã được thêm vào hệ thống và kỹ thuật viên tiếp nhận ngay.`);
      closeModal('createTicketModal');
    }

    // 5. Xem biên bản bàn giao
    function viewHandoverReceipt(code, content, device, date, tech, status) {
      document.getElementById('hoTitle').innerText = `Biên bản bàn giao: #${code}`;
      document.getElementById('hoCode').innerText = `Mã phiếu: #${code} (${status})`;
      document.getElementById('hoDevice').innerText = device;
      document.getElementById('hoContent').innerText = content;
      document.getElementById('hoDate').innerText = date;
      document.getElementById('hoTech').innerText = tech;
      openModal('handoverModal');
    }

    // 6. Xuất thẻ VIP Warranty
    function printVipCard() {
      alert('Đang tạo và tải về mẫu Thẻ thành viên VIP Enterprise (PDF / Mã QR Code điện tử) cho khách hàng Trần Hoàng Nam...');
    }

    // 7. Khóa / Mở khóa hồ sơ
    let isLocked = false;
    function toggleLockAccount() {
      isLocked = !isLocked;
      if (isLocked) {
        alert('Hồ sơ khách hàng KH-10294 đã được chuyển sang chế độ: TẠM KHÓA AN TOÀN.');
      } else {
        alert('Hồ sơ khách hàng KH-10294 đã được MỞ KHÓA HOẠT ĐỘNG BÌNH THƯỜNG.');
      }
    }

    // 8. Thêm ghi chú mới
    function handleAddNote() {
      const input = document.getElementById('newNoteInput');
      const text = input.value.trim();
      if (!text) {
        alert('Vui lòng nhập nội dung ghi chú tương tác!');
        return;
      }

      const container = document.getElementById('notesContainer');
      const now = new Date();
      const timeStr = `${String(now.getDate()).padStart(2, '0')}/${String(now.getMonth()+1).padStart(2, '0')}/${now.getFullYear()} • ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

      const noteDiv = document.createElement('div');
      noteDiv.className = 'border-l-2 border-[#ff6b00] pl-3 space-y-1 bg-amber-50/30 p-2 rounded-r-xl';
      noteDiv.innerHTML = `
        <div class="flex items-center justify-between text-[11px]">
          <span class="font-bold text-slate-900">Admin01 (Điều phối)</span>
          <span class="text-slate-400 font-mono text-[10.5px]">${timeStr}</span>
        </div>
        <p class="text-slate-700 leading-relaxed text-[11.5px]">
          ${text}
        </p>
      `;

      container.insertBefore(noteDiv, container.firstChild);
      input.value = '';
      alert('Đã lưu ghi chú tương tác mới vào hồ sơ!');
    }
  </script>

</body>

</html>

