        <button type="button" onclick="closeModal('addProductModal')" class="text-slate-400 hover:text-slate-600 text-lg cursor-pointer">✕</button>
      </div>

      <form id="addProductForm" onsubmit="handleSaveProduct(event)" class="space-y-4 pt-4 text-xs">
        
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="font-bold text-slate-700 block mb-1">Mã SKU định danh *</label>
            <input type="text" id="newSku" required placeholder="VD: LAP-ASUS-G14"
              class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono font-bold uppercase focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#ff6b00]">
          </div>
          <div>
            <label class="font-bold text-slate-700 block mb-1">Phiên bản / Mã phụ</label>
            <input type="text" id="newSubSku" placeholder="VD: Rev: 2024-B"
              class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#ff6b00]">
          </div>
        </div>

        <div>
          <label class="font-bold text-slate-700 block mb-1">Tên sản phẩm & Model *</label>
          <input type="text" id="newName" required placeholder="VD: Asus ROG Zephyrus G14 OLED"
            class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#ff6b00]">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="font-bold text-slate-700 block mb-1">Danh mục sản phẩm *</label>
            <select id="newCategory" required
              class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#ff6b00]">
              <option value="laptop">Laptop & PC</option>
              <option value="phone">Điện thoại</option>
              <option value="monitor">Màn hình & TV</option>
              <option value="audio">Âm thanh</option>
              <option value="component">Linh kiện</option>
            </select>
          </div>
          <div>
            <label class="font-bold text-slate-700 block mb-1">Giá bán niêm yết (VNĐ) *</label>
            <input type="text" id="newPrice" required placeholder="VD: 45,990,000 đ"
              class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono font-bold focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#ff6b00]">
          </div>
        </div>

        <div>
          <label class="font-bold text-slate-700 block mb-1">Thông số kỹ thuật tóm tắt</label>
          <input type="text" id="newSpecs" placeholder="VD: Ryzen 9 8945HS • RTX 4070 • 32GB LPDDR5X"
            class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-normal focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#ff6b00]">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="font-bold text-slate-700 block mb-1">Mẫu Serial / IMEI tiếp nhận *</label>
            <input type="text" id="newSerial" required placeholder="VD: SN: ASUS-G14-99201"
              class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#ff6b00]">
          </div>
          <div>
            <label class="font-bold text-slate-700 block mb-1">Thời hạn gói bảo hành tiêu chuẩn *</label>
            <select id="newWarranty" required
              class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#ff6b00]">
              <option value="24">24 Tháng chính hãng</option>
              <option value="12">12 Tháng chính hãng</option>
              <option value="36">36 Tháng chính hãng</option>
            </select>
          </div>
        </div>

        <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
          <button type="button" onclick="closeModal('addProductModal')"
            class="px-4 py-2 rounded-xl border border-slate-200 font-bold text-slate-600 hover:bg-slate-50 cursor-pointer">
            Hủy
          </button>
          <button type="submit"
            class="px-5 py-2 rounded-xl bg-[#ff6b00] hover:bg-[#e05800] text-white font-bold cursor-pointer transition-all active:scale-95 shadow-xs">
            Lưu sản phẩm
          </button>
        </div>

      </form>

    </div>
  </div>

  <!-- ==============================================
       MODAL 2: QUÉT MÃ VẠCH / QR CODE SERIAL
  ============================================== -->
  <div id="scanModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 modal-backdrop hidden">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200">
      
      <div class="flex items-center justify-between pb-3.5 border-b border-slate-100">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-[#fff4ec] border border-[#fed7aa] text-[#ff6b00] flex items-center justify-center font-bold">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 7V5a2 2 0 0 1 2-2h2"></path>
              <path d="M17 3h2a2 2 0 0 1 2 2v2"></path>
              <path d="M21 17v2a2 2 0 0 1-2 2h-2"></path>
              <path d="M7 21H5a2 2 0 0 1-2-2v-2"></path>
            </svg>
          </div>
          <h3 class="font-black text-slate-900 text-base">Quét mã vạch / QR Serial</h3>
        </div>
        <button type="button" onclick="closeModal('scanModal')" class="text-slate-400 hover:text-slate-600 text-lg cursor-pointer">✕</button>
      </div>

      <div class="py-5 text-center space-y-4">
        <!-- Khung quét mô phỏng -->
        <div class="w-64 h-48 mx-auto bg-slate-900 rounded-2xl relative overflow-hidden flex flex-col items-center justify-center border-2 border-dashed border-[#ff6b00]">
          <div class="absolute inset-x-4 top-1/2 -translate-y-1/2 h-0.5 bg-[#ff6b00] shadow-[0_0_12px_#ff6b00] animate-pulse"></div>
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-white/40 mb-2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="7" y1="7" x2="17" y2="7"></line>
            <line x1="7" y1="12" x2="17" y2="12"></line>
            <line x1="7" y1="17" x2="13" y2="17"></line>
          </svg>
          <span class="text-white/70 text-xs font-mono">Đang tìm mã vạch...</span>
        </div>

        <div class="space-y-2">
          <p class="text-xs text-slate-500">
            Đặt mã vạch hoặc mã QR in trên vỏ hộp/thân máy vào khung nhận diện phía trên
          </p>
          <div class="flex items-center gap-2 max-w-xs mx-auto">
            <input type="text" id="manualScanInput" placeholder="Hoặc nhập tay số Serial/IMEI..."
              class="flex-1 px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#ff6b00]">
            <button type="button" onclick="handleManualScan()"
              class="px-3.5 py-2 bg-[#ff6b00] text-white rounded-xl text-xs font-bold hover:bg-[#e05800] transition-colors cursor-pointer">
              Tra cứu
            </button>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-end pt-3 border-t border-slate-100">
        <button type="button" onclick="closeModal('scanModal')"
          class="px-4 py-2 rounded-xl border border-slate-200 text-slate-600 font-bold text-xs hover:bg-slate-50 cursor-pointer">
          Đóng
        </button>
      </div>

    </div>
  </div>

  <!-- ==============================================
       4. JAVASCRIPT XỬ LÝ GIAO DIỆN & TÌM KIẾM SẢN PHẨM
  ============================================== -->
  <script>
    // 1. Điều khiển Sidebar Mobile
    function toggleSidebar() {
      const sidebar = document.getElementById('adminSidebar');
      const overlay = document.getElementById('sidebarOverlay');
      sidebar.classList.toggle('-translate-x-full');
      overlay.classList.toggle('hidden');
    }

    // 2. Mở / Đóng Modal
    function openModal(id) {
      document.getElementById(id).classList.remove('hidden');
    }
    function closeModal(id) {
      document.getElementById(id).classList.add('hidden');
    }

    // 3. Mở Modal Thêm sản phẩm
    function openAddProductModal() {
      openModal('addProductModal');
    }

    // 4. Mở Modal Quét mã vạch / QR
    function openScanModal() {
      openModal('scanModal');
    }

    function handleManualScan() {
      const val = document.getElementById('manualScanInput').value.trim();
      if (!val) {
        alert('Vui lòng nhập số Serial hoặc IMEI cần tra cứu!');
        return;
      }
      closeModal('scanModal');
      document.getElementById('searchInput').value = val;
      filterProductTable();
    }

    // 5. Xuất dữ liệu sản phẩm
    function exportProductData() {
      alert('Đang tổng hợp và xuất danh mục 1,482 mã sản phẩm sang tệp Excel (.xlsx)...');
    }

    // 6. Chuyển đổi mật độ hiển thị (Chuẩn / Gọn)
    function setDensity(mode) {
      const btnStandard = document.getElementById('btnStandard');
      const btnCompact = document.getElementById('btnCompact');
      const rows = document.querySelectorAll('#productTable tbody tr');

      if (mode === 'compact') {
        btnCompact.className = 'px-2.5 py-1 rounded-md font-bold text-slate-900 bg-white shadow-2xs transition-all cursor-pointer';
        btnStandard.className = 'px-2.5 py-1 rounded-md font-medium text-slate-500 hover:text-slate-900 transition-all cursor-pointer';
        rows.forEach(r => {
          r.querySelectorAll('td').forEach(td => {
            td.classList.remove('py-4');
            td.classList.add('py-2');
          });
        });
      } else {
        btnStandard.className = 'px-2.5 py-1 rounded-md font-bold text-slate-900 bg-white shadow-2xs transition-all cursor-pointer';
        btnCompact.className = 'px-2.5 py-1 rounded-md font-medium text-slate-500 hover:text-slate-900 transition-all cursor-pointer';
        rows.forEach(r => {
          r.querySelectorAll('td').forEach(td => {
            td.classList.remove('py-2');
            td.classList.add('py-4');
          });
        });
      }
    }

    // 7. Lọc bảng sản phẩm theo từ khoá, danh mục & gói bảo hành
    function filterProductTable() {
      const search = (document.getElementById('searchInput')?.value || '').toLowerCase().trim();
      const category = document.getElementById('categorySelect')?.value || 'all';
      const warranty = document.getElementById('warrantyPeriodSelect')?.value || 'all';
      const rows = document.querySelectorAll('#productTable tbody tr.product-row');

      let visibleCount = 0;

      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        const rowCategory = row.getAttribute('data-category');
        const rowWarranty = row.getAttribute('data-warranty');

        const matchSearch = !search || text.includes(search);
        const matchCategory = category === 'all' || rowCategory === category;
        const matchWarranty = warranty === 'all' || rowWarranty === warranty;

        if (matchSearch && matchCategory && matchWarranty) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      const badge = document.getElementById('targetCountBadge');
      if (badge) {
        badge.innerText = `${visibleCount} sản phẩm mục tiêu`;
      }
    }

    // 8. Thêm sản phẩm mới vào bảng
    function handleSaveProduct(e) {
      e.preventDefault();
      const sku = document.getElementById('newSku').value.trim();
      const subSku = document.getElementById('newSubSku').value.trim() || 'Rev: 2024-STD';
      const name = document.getElementById('newName').value.trim();
      const category = document.getElementById('newCategory').value;
      const price = document.getElementById('newPrice').value.trim();
      const specs = document.getElementById('newSpecs').value.trim() || 'Cấu hình tiêu chuẩn';
      const serial = document.getElementById('newSerial').value.trim();
      const warranty = document.getElementById('newWarranty').value;

      let catLabel = 'Laptop & PC';
      let catIcon = '<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line>';
      if (category === 'phone') {
        catLabel = 'Điện thoại';
        catIcon = '<rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line>';
      } else if (category === 'monitor') {
        catLabel = 'Màn hình & TV';
      } else if (category === 'audio') {
        catLabel = 'Âm thanh';
        catIcon = '<path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>';
      } else if (category === 'component') {
        catLabel = 'Linh kiện';
        catIcon = '<rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line>';
      }

      const tbody = document.querySelector('#productTable tbody');
      const newTr = document.createElement('tr');
      newTr.className = 'hover:bg-slate-50/80 transition-colors product-row bg-emerald-50/20';
      newTr.setAttribute('data-category', category);
      newTr.setAttribute('data-warranty', warranty);
      newTr.setAttribute('data-status', 'selling');

      newTr.innerHTML = `
        <td class="py-4 pl-4 sm:pl-6 pr-4 align-middle">
          <div class="font-mono font-bold text-[#ea580c] text-xs">
            ${sku}
          </div>
          <div class="text-[11px] text-slate-400 mt-0.5">
            ${subSku}
          </div>
        </td>
        <td class="py-4 px-4 align-middle">
          <div class="flex items-center gap-3.5">
            <div class="w-11 h-11 rounded-xl bg-emerald-100 text-emerald-800 font-bold border border-emerald-200 overflow-hidden flex-shrink-0 flex items-center justify-center p-1 text-xs">
              NEW
            </div>
            <div>
              <div class="font-bold text-slate-900 text-sm tracking-tight product-name">
                ${name}
              </div>
              <div class="text-[11.5px] text-slate-500 mt-0.5">
                ${specs}
              </div>
            </div>
          </div>
        </td>
        <td class="py-4 px-4 align-middle">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-50 border border-slate-200 text-slate-700 text-xs font-semibold">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              ${catIcon}
            </svg>
            <span>${catLabel}</span>
          </span>
        </td>
        <td class="py-4 px-4 align-middle">
          <div class="font-mono text-xs">
            <span class="text-slate-400">SN:</span> <strong class="text-slate-800">${serial}</strong>
          </div>
          <div class="text-[11.5px] text-slate-500 mt-0.5">
            Kích hoạt: <strong class="text-slate-800 font-bold">1</strong>
          </div>
        </td>
        <td class="py-4 px-4 align-middle">
          <div class="font-bold text-slate-900 text-xs">
            ${warranty} Tháng chính hãng
          </div>
          <div class="text-[11.5px] text-slate-500 mt-0.5">
            Gói bảo hành điện tử tiêu chuẩn
          </div>
        </td>
        <td class="py-4 pl-4 pr-6 text-right align-middle">
          <div class="font-mono font-black text-slate-900 text-sm tracking-tight">
            ${price}
          </div>
          <div class="text-[11px] text-slate-400 mt-0.5">
            Hôm nay
          </div>
        </td>
      `;

      tbody.insertBefore(newTr, tbody.firstChild);
      closeModal('addProductModal');
      document.getElementById('addProductForm').reset();
      alert(`Đã thêm mã sản phẩm mới [${sku}] - ${name} vào hệ thống thành công!`);
      filterProductTable();
    }

    // 9. Re-index kho mã Serial & IMEI MongoDB
    function triggerReindex() {
      const btn = document.getElementById('btnReindex');
      btn.innerHTML = `
        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-blue-600 inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Đang re-index...</span>
      `;
      btn.disabled = true;

      setTimeout(() => {
        btn.innerHTML = `
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
          </svg>
          <span>Re-index ngay</span>
        `;
        btn.disabled = false;
        alert('Tái lập chỉ mục MongoDB thành công! Độ trễ truy vấn IMEI đạt 4ms.');
      }, 1200);
    }
  </script>

</body>

</html>

