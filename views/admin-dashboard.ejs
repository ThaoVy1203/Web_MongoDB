  <!-- JAVASCRIPT ĐIỀU KHIỂN GIAO DIỆN -->
  <script>
    // Toggle Mobile Sidebar
    function toggleSidebar() {
      const sidebar = document.getElementById('adminSidebar');
      const overlay = document.getElementById('sidebarOverlay');
      sidebar.classList.toggle('-translate-x-full');
      overlay.classList.toggle('hidden');
    }

    // Lọc theo thời gian (Segmented filter pills)
    function setFilter(btn, type) {
      const parent = btn.parentElement;
      const allButtons = parent.querySelectorAll('button');
      allButtons.forEach(b => {
        b.className = 'px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition-all cursor-pointer';
      });
      btn.className = 'px-3 py-1.5 rounded-lg bg-white text-[#d95800] shadow-xs transition-all cursor-pointer font-bold';
    }

    // Xuất báo cáo CSV
    function exportReport() {
      alert('Đang tổng hợp dữ liệu bảo hành 6 tháng gần nhất và xuất định dạng Excel/CSV...');
    }

    // Đồng bộ MongoDB
    function syncMongoDB(btn) {
      btn.classList.add('opacity-75', 'animate-pulse');
      setTimeout(() => {
        btn.classList.remove('opacity-75', 'animate-pulse');
        alert('Đã đồng bộ cơ sở dữ liệu MongoDB thành công! Hệ thống hoạt động với độ trễ 18ms.');
      }, 700);
    }
  </script>

