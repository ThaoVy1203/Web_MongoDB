<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>Tổng quan Hệ thống Quản trị & Vận hành Bảo hành - EXED OPS ADMIN</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Hanken+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary": "#ff6b00",
            "primary-dark": "#e05800",
            "primary-light": "#fff7ed",
            "topbar-dark": "#2a1212",
            "sidebar-active-bg": "#fbeee6",
            "sidebar-active-text": "#8B2500"
          },
          fontFamily: {
            "sans": ["Plus Jakarta Sans", "Hanken Grotesk", "sans-serif"],
            "mono": ["JetBrains Mono", "monospace"]
          }
        }
      }
    }
  </script>

  <style>
    @layer base {
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
    }

    /* Tùy chỉnh thanh cuộn mảnh */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* Hiệu ứng biểu đồ cột */
    .chart-bar {
      transition: height 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s ease;
    }
    .chart-bar:hover {
      transform: scaleY(1.03);
      filter: brightness(1.08);
    }
  </style>
</head>

<body class="bg-[#f8fafc] text-[#111315] antialiased min-h-screen flex flex-col selection:bg-[#ff6b00]/20 selection:text-[#ff6b00]">

  <!-- ==============================================
       1. TOP HEADER TOÀN MÀN HÌNH (DARK BURGUNDY #2a1212)
  ============================================== -->
  <header class="h-20 bg-[#2a1212] text-white sticky top-0 z-50 px-4 sm:px-6 flex items-center justify-between border-b border-black/30 shadow-xs">
    
    <!-- Phía trái: Logo11 nhỏ gọn + Badge ADMIN -->
    <div class="flex items-center gap-3">
      <!-- Nút mở drawer trên mobile -->
      <button type="button" onclick="toggleSidebar()" class="lg:hidden text-white/80 hover:text-white p-1.5 mr-1 cursor-pointer">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <a href="/admin" class="flex items-center group py-1">
        <img src="/images/logo11.png" alt="WarrantyOps Logo" class="h-10 sm:h-11 object-contain transition-transform group-hover:scale-105"
          onerror="this.onerror=null; this.src='/images/logo1.png';">
      </a>

      <span class="bg-black/40 text-white/90 text-[10px] font-bold px-2.5 py-0.5 rounded-full border border-white/20 tracking-wider uppercase ml-1 shadow-2xs">
        ADMIN
      </span>
    </div>

    <!-- Phía phải: Chuông thông báo + Profile Admin01 -->
    <div class="flex items-center gap-4 sm:gap-5">
      
      <!-- Chuông thông báo có chấm cam -->
      <button type="button" onclick="alert('Hệ thống hoạt động bình thường, không có vi phạm SLA!')"
        class="relative text-white/80 hover:text-white transition-colors p-1" title="Thông báo">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <span class="absolute top-0.5 right-0.5 w-2 h-2 rounded-full bg-[#ff6b00]"></span>
      </button>

      <!-- Profile admin01 -->
      <div class="flex items-center gap-2 text-white/90 text-xs font-bold cursor-pointer hover:text-white transition-colors">
        <div class="w-7 h-7 rounded-full bg-[#ff6b00]/25 text-[#ff6b00] border border-[#ff6b00]/40 flex items-center justify-center">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <span>admin01</span>
      </div>

    </div>

  </header>

  <!-- ==============================================
       CONTAINER DƯỚI TOPBAR: SIDEBAR + MAIN CONTENT
  ============================================== -->
  <div class="flex-1 flex min-h-[calc(100vh-5rem)] relative">

    <!-- ==============================================
         2. SIDEBAR TRÁI (WHITE THEME / MENU QUẢN LÝ)
    ============================================== -->
    <aside id="adminSidebar"
      class="w-60 lg:w-64 bg-white border-r border-slate-200/90 flex flex-col justify-between fixed lg:sticky top-20 bottom-0 left-0 z-40 transition-transform duration-300 -translate-x-full lg:translate-x-0 h-[calc(100vh-5rem)] overflow-y-auto">
      
      <!-- Danh sách menu điều hướng -->
      <div class="p-3.5 sm:p-4">
        
        <nav class="space-y-1">
          
          <!-- 1. Tổng quan (Dashboard) - ACTIVE (Nền cam nhạt #fbeee6, Chữ nâu đỏ #8B2500) -->
          <a href="/admin"
            class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-[#fbeee6] text-[#8B2500] font-extrabold text-xs transition-all shadow-2xs">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
            </svg>
            <span>Tổng quan (Dashboard)</span>
          </a>

          <!-- 2. Quản lý khách hàng (Badge 1.4k) -->
          <a href="/admin/khach-hang"
            class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-50 font-medium text-xs transition-all">
            <div class="flex items-center gap-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
              <span>Quản lý khách hàng</span>
            </div>
            <span class="bg-slate-100 text-slate-500 font-semibold text-[10px] px-1.5 py-0.5 rounded">1.4k</span>
          </a>

          <!-- 3. Quản lý sản phẩm -->
          <a href="/admin/san-pham"
            class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-50 font-medium text-xs transition-all">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
            <span>Quản lý sản phẩm</span>
          </a>

          <!-- 4. Hồ sơ bảo hành -->
          <a href="/admin/ho-so-bao-hanh"
            class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-50 font-medium text-xs transition-all">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
            <span>Hồ sơ bảo hành</span>
          </a>

          <!-- 5. Yêu cầu & Xử lý phiếu (Chấm cam nhấp nháy) -->
          <a href="/admin/yeu-cau-bao-hanh"
            class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-50 font-medium text-xs transition-all">
            <div class="flex items-center gap-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                <line x1="9" y1="9" x2="15" y2="9"></line>
                <line x1="9" y1="13" x2="13" y2="13"></line>
              </svg>
              <span>Yêu cầu & Xử lý phiếu</span>
            </div>
            <span class="w-2 h-2 rounded-full bg-[#ff6b00] ring-4 ring-[#ff6b00]/20 animate-pulse"></span>
          </a>

          <!-- 6. Thống kê & Báo cáo -->
          <a href="/admin/thong-ke"
            class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-50 font-medium text-xs transition-all">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
              <polyline points="17 6 23 6 23 12"></polyline>
            </svg>
            <span>Thống kê & Báo cáo</span>
          </a>

        </nav>

      </div>

      <!-- Đáy Sidebar: Chip MongoDB Online -->
      <div class="p-3.5 sm:p-4 border-t border-slate-100">
        <div class="bg-white border border-slate-200/90 rounded-full px-3.5 py-2 flex items-center justify-between shadow-xs text-xs">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-slate-700 font-semibold text-[11px]">MongoDB • OnLine</span>
          </div>
          <div class="text-slate-400">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
              <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
              <line x1="6" y1="6" x2="6.01" y2="6"></line>
              <line x1="6" y1="18" x2="6.01" y2="18"></line>
            </svg>
          </div>
        </div>
      </div>

    </aside>

    <!-- Overlay cho mobile khi mở sidebar -->
    <div id="sidebarOverlay" onclick="toggleSidebar()"
      class="fixed inset-0 bg-black/50 z-30 hidden lg:hidden backdrop-blur-xs"></div>

    <!-- ==============================================
         3. MAIN CONTENT KHU VỰC CHÍNH BÊN PHẢI
    ============================================== -->
    <main class="flex-1 p-4 sm:p-6 lg:p-7 space-y-5 min-w-0">

      <!-- TIÊU ĐỀ TRANG & BỘ LỌC THỜI GIAN -->
      <div class="space-y-3">
        
        <!-- Hàng 1: Tiêu đề TỔNG QUAN HỆ THỐNG nằm ngang chung hàng với bg-slate filter pills -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <h1 class="text-2xl sm:text-[28px] font-black text-[#2a1212] tracking-tight uppercase">
            TỔNG QUAN HỆ THỐNG
          </h1>

          <!-- Segmented Filter Pills (bg-slate) -->
          <div class="bg-slate-200/70 p-1 rounded-xl flex items-center gap-1 text-xs font-bold w-fit">
            <button type="button" onclick="setFilter(this, 'today')"
              class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition-all cursor-pointer">
              Hôm nay
            </button>
            <button type="button" onclick="setFilter(this, '7days')"
              class="px-3 py-1.5 rounded-lg bg-white text-[#d95800] shadow-xs transition-all cursor-pointer">
              7 ngày qua
            </button>
            <button type="button" onclick="setFilter(this, 'month')"
              class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition-all cursor-pointer">
              Tháng này
            </button>
            <button type="button" onclick="setFilter(this, 'custom')"
              class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition-all cursor-pointer flex items-center gap-1">
              <span>Tùy chỉnh</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </button>
          </div>
        </div>

        <!-- Hàng 2: Nằm phía dưới gồm "Xuất báo cáo" và "Đồng bộ MongoDB" -->
        <div class="flex items-center justify-end gap-2 pt-0.5">
          <button type="button" onclick="exportReport()"
            class="bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 text-xs font-bold px-3.5 py-1.5 sm:py-2 rounded-xl shadow-xs flex items-center gap-1.5 cursor-pointer transition-all">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Xuất báo cáo</span>
          </button>

          <button type="button" onclick="syncMongoDB(this)"
            class="bg-[#ff6b00] hover:bg-[#e05800] text-white text-xs font-bold px-3.5 py-1.5 sm:py-2 rounded-xl shadow-xs flex items-center gap-1.5 cursor-pointer transition-all active:scale-95">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
            </svg>
            <span>Đồng bộ MongoDB</span>
          </button>
        </div>

      </div>

      <!-- ==============================================
           ROW 1: 4 THẺ METRIC KPI (CHIỀU CAO THẤP GỌN, KHÔNG ICON)
      ============================================== -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-4">
        
        <!-- CARD 1: HỒ SƠ BẢO HÀNH CÒN HẠN -->
        <div class="bg-white rounded-xl py-3 px-4 border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
          <div class="text-[10.5px] font-bold text-slate-500 uppercase tracking-wider mb-1">
            HỒ SƠ BẢO HÀNH CÒN HẠN
          </div>
          <div class="text-2xl sm:text-[26px] font-black text-slate-900 tracking-tight leading-tight mb-1">
            14,820
          </div>
          <div class="flex items-center gap-1.5 text-xs">
            <span class="inline-flex items-center gap-0.5 bg-amber-50 text-amber-700 font-bold px-1.5 py-0.5 rounded text-[10.5px]">
              ↑ +12.4%
            </span>
            <span class="text-slate-400 font-medium text-[11px]">So với tháng trước</span>
          </div>
        </div>

        <!-- CARD 2: PHIẾU YÊU CẦU ĐANG XỬ LÝ -->
        <div class="bg-white rounded-xl py-3 px-4 border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
          <div class="text-[10.5px] font-bold text-slate-500 uppercase tracking-wider mb-1">
            PHIẾU YÊU CẦU ĐANG XỬ LÝ
          </div>
          <div class="text-2xl sm:text-[26px] font-black text-slate-900 tracking-tight leading-tight mb-1">
            68
          </div>
          <div class="flex items-center gap-1.5 text-xs">
            <span class="inline-flex items-center bg-rose-50 border border-rose-200 text-rose-700 font-bold px-1.5 py-0.5 rounded text-[10.5px]">
              14 phiếu quá SLA
            </span>
            <span class="text-rose-500 font-semibold text-[11px]">Cần xử lý gấp</span>
          </div>
        </div>

        <!-- CARD 3: TỶ LỆ HOÀN TẤT ĐÚNG HẠN (SLA) -->
        <div class="bg-white rounded-xl py-3 px-4 border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
          <div class="text-[10.5px] font-bold text-slate-500 uppercase tracking-wider mb-1">
            TỶ LỆ HOÀN TẤT ĐÚNG HẠN (SLA)
          </div>
          <div class="text-2xl sm:text-[26px] font-black text-slate-900 tracking-tight leading-tight mb-1">
            96.2%
          </div>
          <div class="flex items-center gap-1.5 text-xs">
            <span class="inline-flex items-center gap-0.5 bg-emerald-50 text-emerald-700 font-bold px-1.5 py-0.5 rounded text-[10.5px]">
              ↑ +1.8%
            </span>
            <span class="text-slate-400 font-medium text-[11px]">Mục tiêu: 95.0%</span>
          </div>
        </div>

        <!-- CARD 4: KHÁCH HÀNG ĐANG KÍCH HOẠT -->
        <div class="bg-white rounded-xl py-3 px-4 border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
          <div class="text-[10.5px] font-bold text-slate-500 uppercase tracking-wider mb-1">
            KHÁCH HÀNG ĐANG KÍCH HOẠT
          </div>
          <div class="text-2xl sm:text-[26px] font-black text-slate-900 tracking-tight leading-tight mb-1">
            9,250
          </div>
          <div class="flex items-center gap-1.5 text-xs">
            <span class="inline-flex items-center bg-slate-100 text-slate-700 font-bold px-1.5 py-0.5 rounded text-[10.5px]">
              +85 tuần này
            </span>
            <span class="text-slate-400 font-medium text-[11px]">Toàn hệ thống</span>
          </div>
        </div>

      </div>

      <!-- ==============================================
           ROW 2: BIỂU ĐỒ BAR CHART & PHÂN LOẠI LỖI (DONUT)
      ============================================== -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
        
        <!-- CỘT TRÁI (LG:COL-SPAN-8): BIỂU ĐỒ CỘT THEO THÁNG -->
        <div class="lg:col-span-8 bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs flex flex-col justify-between">
          
          <!-- Header biểu đồ & Legend -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
            <div>
              <h2 class="text-base sm:text-lg font-bold text-slate-900 tracking-tight">
                Tình trạng bảo hành theo tháng (2024)
              </h2>
              <p class="text-xs text-slate-400 font-medium mt-0.5">
                So sánh tương quan giữa số lượng tiếp nhận mới, hoàn tất xử lý và đổi mới linh kiện
              </p>
            </div>

            <!-- Legend 3 nhóm màu -->
            <div class="flex items-center gap-3 text-xs font-semibold flex-wrap">
              <div class="flex items-center gap-1.5">
                <span class="w-3 h-3 rounded-xs bg-[#ff6b00]"></span>
                <span class="text-slate-600">Tiếp nhận (Total)</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-3 h-3 rounded-xs bg-[#111315]"></span>
                <span class="text-slate-600">Hoàn tất sửa</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-3 h-3 rounded-xs bg-[#fbd38d]"></span>
                <span class="text-slate-600">Đổi linh kiện</span>
              </div>
            </div>
          </div>

          <!-- Khu vực Bar Chart 6 tháng (T01 - T06) -->
          <div class="h-64 sm:h-72 w-full flex items-end justify-between pt-6 pb-2 px-2 sm:px-6 border-b border-slate-100 gap-2 sm:gap-4">
            
            <!-- THÁNG 1: T01 -->
            <div class="flex-1 flex flex-col items-center h-full justify-end group">
              <div class="w-full flex items-end justify-center gap-1 sm:gap-1.5 h-full">
                <div class="w-2.5 sm:w-3.5 bg-[#ff6b00] rounded-t-sm chart-bar shadow-2xs" style="height: 48%;" title="T01 - Tiếp nhận: 480 phiếu"></div>
                <div class="w-2.5 sm:w-3.5 bg-[#111315] rounded-t-sm chart-bar shadow-2xs" style="height: 40%;" title="T01 - Hoàn tất: 400 phiếu"></div>
