<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>Đăng nhập &amp; Đăng ký — WarrantyOps</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet">

  <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'system-ui', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          }
        }
      }
    };
  </script>
</head>

<%
  const tabMode = typeof activeTab !== 'undefined' && activeTab === 'register' ? 'register' : 'login';
  const fd = typeof formData !== 'undefined' && formData ? formData : {};
  const redirectTarget = typeof returnTo !== 'undefined' ? returnTo : '';
%>

<body class="font-sans antialiased text-slate-900 bg-slate-50 min-h-screen flex flex-col justify-center py-10 px-4 sm:px-6 relative">

  <div class="absolute top-5 left-5">
    <a href="/"
      class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-100 text-xs font-semibold text-slate-700 border border-slate-200 shadow-xs transition-colors">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      Về trang chủ
    </a>
  </div>

  <div class="max-w-5xl w-full mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">

    <!-- Left Brand Info -->
    <div class="lg:col-span-6 space-y-5">
      <a href="/" class="inline-block">
        <img src="/images/logo1.png" alt="WarrantyOps Logo" class="h-20 object-contain"
          onerror="this.onerror=null; this.src='/images/logo.png';">
      </a>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 leading-tight">
        Nền tảng Quản lý Giấy tờ &amp;<br>
        <span class="text-orange-600">Theo dõi Bảo hành Tập trung</span>
      </h1>
      <p class="text-sm text-slate-600 leading-relaxed max-w-md">
        Lưu trữ toàn bộ phiếu bảo hành điện tử, nhận cảnh báo thiết bị sắp hết hạn và theo dõi tiến độ kỹ thuật viên xử lý theo thời gian thực.
      </p>

      <div class="bg-white border border-slate-200 rounded-2xl p-4 max-w-md space-y-2.5">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Tài khoản dùng thử nhanh</div>
        <div class="flex flex-wrap gap-2">
          <button type="button" onclick="fillDemoAccount('tuan.tran@gmail.com', '123456')"
            class="px-3 py-1.5 rounded-lg bg-slate-50 hover:bg-orange-50 border border-slate-200 hover:border-orange-300 text-xs font-semibold text-slate-700 transition-colors cursor-pointer">
            Khách hàng VIP (Trần Anh Tuấn)
          </button>
          <button type="button" onclick="fillDemoAccount('admin@warrantyops.com', 'admin123')"
            class="px-3 py-1.5 rounded-lg bg-slate-50 hover:bg-orange-50 border border-slate-200 hover:border-orange-300 text-xs font-semibold text-slate-700 transition-colors cursor-pointer">
            Quản trị Admin (admin01)
          </button>
        </div>
      </div>
    </div>

    <!-- Right Auth Card -->
    <div class="lg:col-span-6 flex justify-center">
      <div class="w-full max-w-[450px] bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8">

        <% if (typeof successMessage !== 'undefined' && successMessage) { %>
          <div class="mb-5 p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-medium flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span><%= successMessage %></span>
          </div>
        <% } %>

        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
          <div class="mb-5 p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-medium flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span><%= errorMessage %></span>
          </div>
        <% } %>

        <!-- Tabs -->
        <div class="grid grid-cols-2 gap-2 p-1 bg-slate-100 rounded-xl mb-6">
          <button id="tabLoginBtn" type="button" onclick="switchAuthTab('login')"
            class="py-2.5 px-3 rounded-lg text-xs font-bold transition-all cursor-pointer <%= tabMode === 'register' ? 'text-slate-600 hover:text-slate-900' : 'bg-white text-slate-900 shadow-xs' %>">
            Đăng nhập
          </button>
          <button id="tabRegisterBtn" type="button" onclick="switchAuthTab('register')"
            class="py-2.5 px-3 rounded-lg text-xs font-bold transition-all cursor-pointer <%= tabMode === 'register' ? 'bg-white text-slate-900 shadow-xs' : 'text-slate-600 hover:text-slate-900' %>">
            Đăng ký tài khoản
          </button>
        </div>

        <!-- TAB 1: LOGIN -->
        <div id="loginFormContainer" class="<%= tabMode === 'register' ? 'hidden' : 'block' %>">
          <form action="/dang-nhap" method="POST" class="space-y-4">
            <input type="hidden" name="returnTo" value="<%= redirectTarget %>">

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1.5">Email hoặc số điện thoại</label>
              <input type="text" name="email" id="loginEmailInput" required
                value="<%= fd.email || '' %>"
                placeholder="tuan.tran@gmail.com hoặc 0912345891"
                class="w-full bg-slate-50 border border-slate-200 text-slate-900 text-sm rounded-xl py-2.5 px-3.5 focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1.5">Mật khẩu</label>
              <div class="relative">
                <input type="password" name="password" id="loginPasswordInput" required
                  placeholder="Nhập mật khẩu"
                  class="w-full bg-slate-50 border border-slate-200 text-slate-900 text-sm rounded-xl py-2.5 pl-3.5 pr-10 focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
                <button type="button" onclick="togglePw('loginPasswordInput')"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 cursor-pointer text-xs font-medium">
                  Hiện
                </button>
              </div>
            </div>

            <div class="flex items-center justify-between text-xs">
              <label class="flex items-center gap-2 cursor-pointer select-none">
                <input type="checkbox" name="remember" checked class="rounded border-slate-300 text-orange-600 focus:ring-orange-500">
                <span class="text-slate-600 font-medium">Duy trì đăng nhập 7 ngày</span>
              </label>
            </div>

            <button type="submit"
              class="w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold text-sm py-2.5 px-4 rounded-xl transition-colors cursor-pointer">
              Đăng nhập hệ thống
            </button>
          </form>
        </div>

        <!-- TAB 2: REGISTER -->
        <div id="registerFormContainer" class="<%= tabMode === 'register' ? 'block' : 'hidden' %>">
          <form action="/dang-ky" method="POST" class="space-y-3.5">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Họ và tên <span class="text-rose-500">*</span></label>
              <input type="text" name="fullname" required value="<%= fd.fullname || '' %>" placeholder="Nguyễn Văn An"
                class="w-full bg-slate-50 border border-slate-200 text-slate-900 text-sm rounded-xl py-2.5 px-3.5 focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Email <span class="text-rose-500">*</span></label>
                <input type="text" name="email" required value="<%= fd.email || '' %>" placeholder="ban@email.com"
                  class="w-full bg-slate-50 border border-slate-200 text-slate-900 text-sm rounded-xl py-2.5 px-3.5 focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Số điện thoại</label>
                <input type="tel" name="phone" value="<%= fd.phone || '' %>" placeholder="0901234567"
                  class="w-full bg-slate-50 border border-slate-200 text-slate-900 text-sm rounded-xl py-2.5 px-3.5 focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Mật khẩu (tối thiểu 6 ký tự) <span class="text-rose-500">*</span></label>
              <input type="password" name="password" id="regPasswordInput" minlength="6" required placeholder="••••••••"
                class="w-full bg-slate-50 border border-slate-200 text-slate-900 text-sm rounded-xl py-2.5 px-3.5 focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Xác nhận mật khẩu <span class="text-rose-500">*</span></label>
              <input type="password" name="confirmPassword" minlength="6" required placeholder="••••••••"
                class="w-full bg-slate-50 border border-slate-200 text-slate-900 text-sm rounded-xl py-2.5 px-3.5 focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500">
            </div>

            <label class="flex items-start gap-2 text-xs pt-1 cursor-pointer">
              <input type="checkbox" name="terms" required checked class="mt-0.5 rounded border-slate-300 text-orange-600 focus:ring-orange-500">
              <span class="text-slate-600">Đồng ý khởi tạo hồ sơ bảo hành điện tử trên hệ thống WarrantyOps.</span>
            </label>

            <button type="submit"
              class="w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold text-sm py-2.5 px-4 rounded-xl transition-colors cursor-pointer">
              Tạo tài khoản mới
            </button>
          </form>
        </div>

      </div>
    </div>

  </div>

  <script>
    function switchAuthTab(tab) {
      const loginBtn = document.getElementById('tabLoginBtn');
      const regBtn = document.getElementById('tabRegisterBtn');
      const loginBox = document.getElementById('loginFormContainer');
      const regBox = document.getElementById('registerFormContainer');

      if (tab === 'login') {
        loginBtn.className = 'py-2.5 px-3 rounded-lg text-xs font-bold transition-all cursor-pointer bg-white text-slate-900 shadow-xs';
        regBtn.className = 'py-2.5 px-3 rounded-lg text-xs font-bold transition-all cursor-pointer text-slate-600 hover:text-slate-900';
        loginBox.classList.remove('hidden');
        regBox.classList.add('hidden');
      } else {
        regBtn.className = 'py-2.5 px-3 rounded-lg text-xs font-bold transition-all cursor-pointer bg-white text-slate-900 shadow-xs';
        loginBtn.className = 'py-2.5 px-3 rounded-lg text-xs font-bold transition-all cursor-pointer text-slate-600 hover:text-slate-900';
        regBox.classList.remove('hidden');
        loginBox.classList.add('hidden');
      }
    }

    function togglePw(id) {
      const input = document.getElementById(id);
      if (input) input.type = input.type === 'password' ? 'text' : 'password';
    }

    function fillDemoAccount(email, pw) {
      switchAuthTab('login');
      document.getElementById('loginEmailInput').value = email;
      document.getElementById('loginPasswordInput').value = pw;
    }
  </script>

</body>
</html>
