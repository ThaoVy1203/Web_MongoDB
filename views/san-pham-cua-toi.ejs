          <!-- ==============================================
       6. JAVASCRIPT XỬ LÝ TƯƠNG TÁC (TÌM KIẾM, LỌC, MODAL)
  ============================================== -->
          <script>
            (function () {
              const tabs = document.querySelectorAll('.filter-tab');
              const cards = document.querySelectorAll('.product-card');
              const searchInput = document.getElementById('product-search');
              const emptyState = document.getElementById('empty-state');
              const resetBtn = document.getElementById('btn-reset-filter');

              let currentFilter = 'all';
              let currentQuery = '';

              function applyFilterAndSearch() {
                let visibleCount = 0;

                cards.forEach(card => {
                  const cardStatus = card.getAttribute('data-status');
                  const cardData = (card.getAttribute('data-search') || '').toLowerCase();

                  let matchesTab = false;
                  if (currentFilter === 'all') {
                    matchesTab = true;
                  } else if (currentFilter === 'active' && cardStatus === 'active') {
                    matchesTab = true;
                  } else if (currentFilter === 'expiring' && cardStatus === 'expiring') {
                    matchesTab = true;
                  } else if (currentFilter === 'expired' && cardStatus === 'expired') {
                    matchesTab = true;
                  }

                  const matchesQuery = !currentQuery || cardData.includes(currentQuery);

                  if (matchesTab && matchesQuery) {
                    card.style.display = 'flex';
                    visibleCount++;
                  } else {
                    card.style.display = 'none';
                  }
                });

                if (visibleCount === 0) {
                  if (emptyState) emptyState.classList.remove('hidden');
                } else {
                  if (emptyState) emptyState.classList.add('hidden');
                }
              }

              tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                  tabs.forEach(t => {
                    t.classList.remove('bg-[#ff6b00]', 'text-white', 'shadow-sm');
                    t.classList.add('bg-slate-100', 'text-[#111315]');
                  });
                  tab.classList.remove('bg-slate-100', 'text-[#111315]');
                  tab.classList.add('bg-[#ff6b00]', 'text-white', 'shadow-sm');

                  currentFilter = tab.getAttribute('data-filter');
                  applyFilterAndSearch();
                });
              });

              if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                  currentQuery = e.target.value.trim().toLowerCase();
                  applyFilterAndSearch();
                });
              }

              if (resetBtn) {
                resetBtn.addEventListener('click', () => {
                  currentFilter = 'all';
                  currentQuery = '';
                  if (searchInput) searchInput.value = '';
                  tabs.forEach((t, i) => {
                    if (i === 0) {
                      t.classList.add('bg-[#ff6b00]', 'text-white', 'shadow-sm');
                      t.classList.remove('bg-slate-100', 'text-[#111315]');
                    } else {
                      t.classList.remove('bg-[#ff6b00]', 'text-white', 'shadow-sm');
                      t.classList.add('bg-slate-100', 'text-[#111315]');
                    }
                  });
                  applyFilterAndSearch();
                });
              }

              // Xử lý Modal Kích hoạt Serial
              const modal = document.getElementById('modal-register');
              const openBtn = document.getElementById('btn-add-serial');
              const closeBtn = document.getElementById('modal-close');
              const cancelBtn = document.getElementById('modal-cancel');
              const scanQrBtn = document.getElementById('btn-scan-qr');

              function openModal() {
                if (modal) {
                  modal.classList.remove('hidden');
                  modal.classList.add('flex');
                }
              }

              function closeModal() {
                if (modal) {
                  modal.classList.add('hidden');
                  modal.classList.remove('flex');
                }
              }

              if (openBtn) openBtn.addEventListener('click', openModal);
              if (closeBtn) closeBtn.addEventListener('click', closeModal);
              if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

              if (scanQrBtn) {
                scanQrBtn.addEventListener('click', () => {
                  alert('Hệ thống đang mở luồng quét nhận dạng QR Code thiết bị từ camera máy tính / điện thoại...');
                });
              }
            })();

            // Modal Đăng nhập
            function openLoginModal() {
              document.getElementById('loginModal').classList.add('active');
            }
            function closeLoginModal() {
              document.getElementById('loginModal').classList.remove('active');
            }

            // Đóng khi click ngoài modal
            window.onclick = function (e) {
              const lM = document.getElementById('loginModal');
              const rM = document.getElementById('modal-register');
              if (e.target === lM) closeLoginModal();
              if (e.target === rM) {
                rM.classList.add('hidden');
                rM.classList.remove('flex');
              }
            };
          </script>

