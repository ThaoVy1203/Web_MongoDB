<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <meta content="web_standard" name="shell-type" />
  <title>Sản Phẩm Của Tôi - WarrantyOps Portal</title>

  <!-- Google Fonts & Material Symbols -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Hanken+Grotesk:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet" />

  <!-- CSS chung của hệ thống -->
  <link rel="stylesheet" href="/css/style.css">

  <style>
    @layer base {

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        overscroll-behavior: none;
      }

      main> :first-child {
        margin-top: 0 !important;
      }

      main> :last-child {
        margin-bottom: 0 !important;
      }
    }

    ::-webkit-scrollbar {
      display: none;
    }
  </style>

  <!-- Tailwind CSS CDN & Cấu hình chính xác theo mã thiết kế -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "surface-dim": "#d6dae4",
            "inverse-surface": "#2c3138",
            "secondary-container": "#e2e2e5",
            "on-surface-variant": "#5a4136",
            "surface-variant": "#dee2ed",
            "on-error": "#ffffff",
            "on-primary-fixed": "#351000",
            "on-secondary-fixed": "#1a1c1e",
            "surface-tint": "#a04100",
            "on-background": "#171c23",
            "primary": "#ff6b00",
            "primary-dark": "#a04100",
            "tertiary-container": "#98999b",
            "error-container": "#ffdad6",
            "on-secondary-container": "#636467",
            "surface-container-high": "#e4e8f2",
            "on-primary": "#ffffff",
            "on-secondary": "#ffffff",
            "surface-container": "#eaeef8",
            "surface-container-highest": "#dee2ed",
            "on-primary-container": "#572000",
            "secondary-fixed": "#e2e2e5",
            "inverse-on-surface": "#ecf1fb",
            "surface-container-lowest": "#ffffff",
            "outline-variant": "#e2bfb0",
            "background": "#f6f7f9",
            "primary-container": "#ff6b00",
            "surface-bright": "#f8f9ff",
            "outline": "#8e7164",
            "secondary": "#5d5e61",
            "surface": "#f6f7f9",
            "on-surface": "#171c23",
            "surface-container-low": "#eff4fe",
            "error": "#ba1a1a",
            "on-error-container": "#93000a",
            "industrial-orange": "#ff6b00",
            "industrial-dark": "#111315",
            "industrial-carbon": "#1c1e22",
            "industrial-gray": "#f6f7f9",
            "industrial-border": "#e2e4e8"
          },
          borderRadius: {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "2xl": "1rem",
            "full": "9999px"
          },
          spacing: {
            "space-xs": "0.25rem",
            "margin-mobile": "1.25rem",
            "space-lg": "1.5rem",
            "space-xl": "2.5rem",
            "space-sm": "0.5rem",
            "space-md": "1rem",
            "gutter-mobile": "1rem",
            "gutter": "1.5rem",
            "margin": "3rem",
            "gutter-desktop": "1.5rem"
          },
          fontFamily: {
            "headline-sm": ["Plus Jakarta Sans", "Space Grotesk", "sans-serif"],
            "headline-xl": ["Plus Jakarta Sans", "Space Grotesk", "sans-serif"],
            "headline-md": ["Plus Jakarta Sans", "Space Grotesk", "sans-serif"],
            "headline-lg": ["Plus Jakarta Sans", "Space Grotesk", "sans-serif"],
            "body-lg": ["Plus Jakarta Sans", "Hanken Grotesk", "sans-serif"],
            "body-md": ["Plus Jakarta Sans", "Hanken Grotesk", "sans-serif"],
            "body-sm": ["Plus Jakarta Sans", "Hanken Grotesk", "sans-serif"],
            "label-sm": ["JetBrains Mono", "monospace"],
            "label-md": ["Plus Jakarta Sans", "Hanken Grotesk", "sans-serif"],
            "code-sm": ["JetBrains Mono", "monospace"],
            "display-lg": ["Plus Jakarta Sans", "Space Grotesk", "sans-serif"]
          }
        }
      }
    };
  </script>
</head>

<body
  class="bg-[#f6f7f9] font-body-md text-body-md text-on-surface antialiased selection:bg-[#ff6b00]/20 selection:text-[#ff6b00]">

  <!-- ==============================================
       1. TOP NAVBAR / HEADER (ĐỒNG BỘ 100% VỚI INDEX.EJS)
  ============================================== -->
  <header class="site-header">
    <div class="container header-wrap">
      <!-- Logo góc trên cùng bên trái với logo1.png -->
      <a href="/" class="brand-area">
        <img src="/images/logo1.png" alt="WarrantyOps Logo" class="brand-logo-img"
          onerror="this.onerror=null; this.src='/images/logo.png';">
      </a>

      <!-- Menu Điều Hướng Chính -->
      <nav class="header-nav-menu">
        <a href="/" class="nav-menu-link">Trang chủ</a>
        <a href="/tra-cuu" class="nav-menu-link">Tra cứu bảo hành</a>
        <a href="/san-pham-cua-toi" class="nav-menu-link active">Sản phẩm của tôi</a>
        <a href="/gui-yeu-cau" class="nav-menu-link">Gửi yêu cầu bảo hành</a>
        <a href="/#liveTrackerSection" class="nav-menu-link">Theo dõi bảo hành</a>
      </nav>

      <!-- Phía phải: Hotline & Đăng nhập -->
      <div class="header-right">
        <button class="icon-search-btn" title="Tìm kiếm nhanh" onclick="window.location.href='/tra-cuu'">
          <span>🔍</span>
        </button>
        <button class="btn-login" onclick="openLoginModal()">
          Đăng nhập
        </button>
      </div>
    </div>
  </header>

  <!-- ==============================================
       THÔNG BÁO FLASH (NẾU CÓ)
  ============================================== -->
  <% if (typeof successMessage !=='undefined' && successMessage) { %>
    <div class="max-w-7xl mx-auto px-gutter-desktop pt-4">
      <div
        class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl flex items-center justify-between text-sm shadow-sm">
        <span>✅ <%= successMessage %></span>
        <button onclick="this.parentElement.style.display='none'"
          class="text-emerald-800 text-lg cursor-pointer">&times;</button>
      </div>
    </div>
    <% } %>

      <% if (typeof errorMessage !=='undefined' && errorMessage) { %>
        <div class="max-w-7xl mx-auto px-gutter-desktop pt-4">
          <div
            class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl flex items-center justify-between text-sm shadow-sm">
            <span>⚠️ <%= errorMessage %></span>
            <button onclick="this.parentElement.style.display='none'"
              class="text-red-800 text-lg cursor-pointer">&times;</button>
          </div>
        </div>
        <% } %>

          <!-- ==============================================
       2. MAIN CONTENT (THIẾT KẾ CHUẨN XÁC THEO CODE MẪU)
  ============================================== -->
          <main class="w-full py-8 bg-[#f6f7f9] min-h-[calc(100vh-16rem)]">
            <div class="flex flex-col w-full">
              <div class="w-full max-w-7xl mx-auto px-gutter-desktop flex flex-col gap-space-xl">

                <!-- Top Workspace Masthead & Executive Summary -->
                <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-lg">
                  <div class="flex flex-col gap-space-xs">
                    <div class="flex items-center gap-space-xs text-[#ff6b00]">
                      <span class="material-symbols-outlined text-[18px]">verified</span>
                      <span class="font-label-sm text-label-sm uppercase tracking-wider font-bold">Tài khoản khách hàng
                        cá nhân</span>
                      <span class="text-slate-400 font-code-sm text-code-sm">/</span>
                      <span
                        class="font-code-sm text-code-sm text-[#111315] bg-[#ff6b00]/10 px-2 py-0.5 rounded font-semibold border border-[#ff6b00]/30">CUST-88392-HCM</span>
                    </div>
                    <h1 class="font-headline-xl text-headline-xl text-[#111315] font-bold tracking-tight">Sản phẩm đã
                      đăng ký bảo hành</h1>
                    <p class="font-body-md text-body-md text-slate-600 max-w-2xl">
                      Quản lý toàn bộ danh mục tài sản số, giám sát chỉ số SLA sửa chữa, theo dõi thời hạn hiệu lực và
                      tạo phiếu can thiệp kỹ thuật trực tuyến 24/7.
                    </p>
                  </div>

                  <!-- Quick Action Gateway -->
                  <div class="flex flex-wrap sm:flex-nowrap items-center gap-space-sm shrink-0">
                    <button
                      class="h-11 px-space-md bg-white hover:bg-slate-50 text-[#111315] border border-[#e2e4e8] rounded-xl font-body-md font-semibold text-[14px] flex items-center gap-space-xs shadow-sm transition-all duration-150 cursor-pointer"
                      id="btn-scan-qr">
                      <span class="material-symbols-outlined text-[#ff6b00] text-[20px]">qr_code_scanner</span>
                      <span>Quét mã QR thiết bị</span>
                    </button>
                    <button
                      class="h-11 px-space-lg bg-[#ff6b00] hover:bg-[#e05e00] text-white rounded-xl font-body-md font-bold text-[14px] flex items-center gap-space-xs shadow-md shadow-[#ff6b00]/25 transition-all duration-150 cursor-pointer"
                      id="btn-add-serial">
                      <span class="material-symbols-outlined text-[20px]">add_circle</span>
                      <span>+ Đăng ký Serial / IMEI mới</span>
                    </button>
                  </div>
                </div>

                <!-- Metrics Bento Strip -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">
                  <!-- Total Devices -->
                  <div
                    class="p-space-lg bg-white rounded-2xl border border-[#e2e4e8] shadow-sm flex items-center justify-between transition-all hover:border-[#ff6b00]/40 hover:shadow-md">
                    <div class="flex flex-col">
                      <span class="font-label-sm text-[12px] uppercase tracking-wider text-slate-500 font-semibold">Tổng
                        thiết bị liên kết</span>
                      <span
                        class="font-headline-xl text-[34px] leading-tight font-extrabold text-[#111315] mt-space-xs">
                        <%= typeof stats !=='undefined' ? String(stats.total).padStart(2, '0' ) : '03' %>
                      </span>
                      <span class="font-body-sm text-[12px] text-slate-500 mt-1">Đã định danh phần cứng</span>
                    </div>
                    <div
                      class="w-12 h-12 rounded-xl bg-orange-50 border border-orange-200 flex items-center justify-center text-[#ff6b00]">
                      <span class="material-symbols-outlined text-[26px]">devices_other</span>
                    </div>
                  </div>

                  <!-- Active Warranties -->
                  <div
                    class="p-space-lg bg-white rounded-2xl border border-[#e2e4e8] shadow-sm flex items-center justify-between transition-all hover:border-[#ff6b00]/50 hover:shadow-md">
                    <div class="flex flex-col">
                      <span class="font-label-sm text-[12px] uppercase tracking-wider text-slate-500 font-semibold">Đang
                        hiệu lực (Active)</span>
                      <span
                        class="font-headline-xl text-[34px] leading-tight font-extrabold text-[#ff6b00] mt-space-xs">
                        <%= typeof stats !=='undefined' ? String(stats.active).padStart(2, '0' ) : '02' %>
                      </span>
                      <span class="font-body-sm text-[12px] text-slate-500 mt-1">Bảo lãnh trực tiếp hãng</span>
                    </div>
                    <div
                      class="w-12 h-12 rounded-xl bg-orange-50 border border-[#ff6b00]/30 flex items-center justify-center text-[#ff6b00]">
                      <span class="material-symbols-outlined text-[26px]">security</span>
                    </div>
                  </div>

                  <!-- Expiring Soon / High Priority -->
                  <div
                    class="p-space-lg bg-white rounded-2xl border border-[#e2e4e8] shadow-sm flex items-center justify-between transition-all hover:border-[#ff6b00]/40 hover:shadow-md">
                    <div class="flex flex-col">
                      <span class="font-label-sm text-[12px] uppercase tracking-wider text-slate-500 font-semibold">Sắp
                        hết hạn (≤ 30 ngày)</span>
                      <span
                        class="font-headline-xl text-[34px] leading-tight font-extrabold text-[#111315] mt-space-xs">
                        <%= typeof stats !=='undefined' ? String(stats.expiring).padStart(2, '0' ) : '00' %>
                      </span>
                      <span class="font-body-sm text-[12px] text-slate-500 mt-1">Không có cảnh báo khẩn</span>
                    </div>
                    <div
                      class="w-12 h-12 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-600">
                      <span class="material-symbols-outlined text-[26px]">alarm</span>
                    </div>
                  </div>

                  <!-- Expired Assets -->
                  <div
                    class="p-space-lg bg-white rounded-2xl border border-[#e2e4e8] shadow-sm flex items-center justify-between transition-all hover:border-error/40 hover:shadow-md">
                    <div class="flex flex-col">
                      <span class="font-label-sm text-[12px] uppercase tracking-wider text-slate-500 font-semibold">Đã
                        quá hạn bảo lãnh</span>
                      <span class="font-headline-xl text-[34px] leading-tight font-extrabold text-error mt-space-xs">
                        <%= typeof stats !=='undefined' ? String(stats.expired).padStart(2, '0' ) : '01' %>
                      </span>
                      <span class="font-body-sm text-[12px] text-slate-500 mt-1">Đủ điều kiện gói Out-Warranty</span>
                    </div>
                    <div
                      class="w-12 h-12 rounded-xl bg-error-container border border-error/20 flex items-center justify-center text-error">
                      <span class="material-symbols-outlined text-[26px]">history_toggle_off</span>
                    </div>
                  </div>
                </div>

                <!-- Interactive Filter Toolbar -->
                <div
                  class="bg-white p-space-md rounded-2xl border border-[#e2e4e8] shadow-sm flex flex-col md:flex-row items-stretch md:items-center justify-between gap-space-md">
                  <!-- Filter Chips -->
                  <div class="flex items-center gap-space-xs overflow-x-auto pb-1 md:pb-0" id="filter-container">
                    <button
                      class="filter-tab px-space-md py-2 rounded-xl bg-[#ff6b00] text-white font-body-md font-bold text-[14px] whitespace-nowrap shadow-sm transition-colors cursor-pointer"
                      data-filter="all">
                      Tất cả (<%= typeof stats !=='undefined' ? stats.total : 3 %>)
                    </button>
                    <button
                      class="filter-tab px-space-md py-2 rounded-xl bg-slate-100 hover:bg-orange-50 text-[#111315] border border-slate-200 font-body-md font-medium text-[14px] whitespace-nowrap transition-colors cursor-pointer"
                      data-filter="active">
                      Còn bảo hành (<%= typeof stats !=='undefined' ? stats.active : 2 %>)
                    </button>
                    <button
                      class="filter-tab px-space-md py-2 rounded-xl bg-slate-100 hover:bg-orange-50 text-[#111315] border border-slate-200 font-body-md font-medium text-[14px] whitespace-nowrap transition-colors cursor-pointer"
                      data-filter="expiring">
                      Sắp hết hạn ≤ 30 ngày (<%= typeof stats !=='undefined' ? stats.expiring : 0 %>)
                    </button>
                    <button
                      class="filter-tab px-space-md py-2 rounded-xl bg-slate-100 hover:bg-orange-50 text-[#111315] border border-slate-200 font-body-md font-medium text-[14px] whitespace-nowrap transition-colors cursor-pointer"
                      data-filter="expired">
                      Đã hết hạn (<%= typeof stats !=='undefined' ? stats.expired : 1 %>)
                    </button>
                  </div>

                  <!-- Quick Search Bar -->
                  <div class="relative w-full md:w-80">
                    <span
                      class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[18px] text-slate-400">search</span>
                    <input
                      class="w-full pl-9 pr-space-md py-2 bg-slate-50 border border-[#e2e4e8] rounded-xl font-body-md text-body-md text-[#111315] placeholder:text-slate-400 focus:outline-none focus:border-[#ff6b00] focus:bg-white shadow-inner transition-colors"
                      id="product-search" placeholder="Tìm theo tên máy, model, số Serial..." type="text" />
                  </div>
                </div>

                <!-- Products Grid (Cards Layout) -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter-desktop items-stretch" id="product-grid">

                  <!-- CARD 1: Dell XPS 15 9530 OLED -->
                  <div
                    class="product-card flex flex-col bg-white rounded-2xl border border-[#e2e4e8] shadow-sm hover:shadow-lg hover:border-[#ff6b00]/40 transition-all duration-200 overflow-hidden"
                    data-search="dell xps 15 9530 oled dlxps-99281-vn laptop may tinh xach tay cao cap"
                    data-status="active">
                    <!-- Card Top Bar & Media -->
                    <div class="relative h-48 w-full bg-slate-100 overflow-hidden">
                      <img class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
                        data-alt="Dell XPS OLED laptop"
                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuA_OaiXk-FRUmjeDE8SJEVtis3DAQM0sBG2GCNkpmaRSWtSQFxf_8AUGlaOKH8A_LiqGjooSvaASvO3Xo9zTgMbZ1GXm7rzfnbeKm5bytMvBx_8FH8yDqocu-DyG5Z1hh5w6PHbZ7MyKRAVSbOfbfjiimOYg73ogZQSWIYsxVejCU4wUWuVnh1Ds6o_N62u16W9RnJLSH5QN2drq9SK0bACiRCLD1y0NL0KxTlMVMw"
                        onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1593642632823-8f785ba67e45?auto=format&fit=crop&w=600&q=80';" />
                      <div class="absolute inset-0 bg-gradient-to-t from-[#111315]/85 via-transparent to-transparent">
                      </div>

                      <!-- Status Pill -->
                      <div
                        class="absolute top-space-md left-space-md flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#ff6b00] text-white font-label-sm text-[12px] font-semibold shadow-md">
                        <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
                        <span>Còn hạn 142 ngày</span>
                      </div>

                      <!-- Quick ID Tag -->
                      <div
                        class="absolute bottom-space-sm left-space-md right-space-md flex items-center justify-between text-white">
                        <span
                          class="font-code-sm text-code-sm bg-[#111315]/80 backdrop-blur-sm px-2.5 py-0.5 rounded-md border border-[#2d3139] text-white">DLXPS-99281-VN</span>
                        <span class="font-label-sm text-label-sm opacity-90 flex items-center gap-1">
                          <span class="material-symbols-outlined text-[16px] text-[#ff7a00]">verified</span> Chính hãng
                        </span>
                      </div>
                    </div>

                    <!-- Card Content Body -->
                    <div class="p-space-lg flex-1 flex flex-col justify-between gap-space-md">
                      <div class="flex flex-col gap-space-xs">
                        <div class="flex items-center justify-between">
                          <span
                            class="font-label-sm text-[11px] uppercase tracking-wider text-[#ff6b00] font-bold bg-[#ff6b00]/10 px-2 py-0.5 rounded border border-[#ff6b00]/30">Máy
                            tính xách tay cao cấp</span>
                          <span class="font-body-sm text-body-sm text-slate-400">Mua: 15/10/2023</span>
                        </div>
                        <h2 class="font-headline-sm text-headline-sm text-[#111315] font-bold leading-tight mt-1">
                          Dell XPS 15 9530 OLED (i9-13900H / 32GB)
                        </h2>
                        <!-- Tier Badge & Benefit List -->
                        <div
                          class="mt-space-xs p-space-sm bg-slate-50 border border-[#e2e4e8] rounded-xl flex flex-col gap-1">
                          <div class="flex items-center gap-1.5 text-[#ff6b00]">
                            <span class="material-symbols-outlined text-[18px]">verified_user</span>
                            <span class="font-body-md font-bold text-[#111315] text-[14px]">ProSupport Plus tận nơi
                              24/7</span>
                          </div>
                          <p class="font-body-sm text-body-sm text-slate-600">
                            Đặc quyền: Kỹ thuật viên kiểm tra tại gia trong 4 giờ, bảo hành rơi vỡ ngập nước (Complete
                            Care).
                          </p>
                        </div>
                        <!-- SLA Lifecycle Tracker Bar -->
                        <div class="mt-space-sm flex flex-col gap-1">
                          <div class="flex justify-between items-center font-label-sm text-label-sm text-slate-500">
                            <span>Vòng đời bảo hành (730 ngày)</span>
                            <span class="text-[#ff6b00] font-bold">Đã qua 80%</span>
                          </div>
                          <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden border border-[#e2e4e8]">
                            <div class="h-full bg-[#ff6b00] rounded-full" style="width: 80.5%;"></div>
                          </div>
                        </div>
                      </div>

                      <!-- Action Stack -->
                      <div class="flex flex-col gap-space-xs pt-space-sm">
                        <a class="w-full h-10 bg-[#ff6b00] hover:bg-[#e05e00] text-white rounded-xl font-body-md text-[14px] font-bold flex items-center justify-center gap-space-xs shadow-sm shadow-[#ff6b00]/25 transition-all"
                          href="/gui-yeu-cau?serial=DLXPS-99281-VN">
                          <span class="material-symbols-outlined text-[18px]">build</span>
                          <span>Gửi yêu cầu bảo hành</span>
                        </a>
                        <div class="grid grid-cols-2 gap-space-xs">
                          <a href="/tra-cuu?serial=DLXPS-99281-VN"
                            class="h-9 px-space-xs bg-slate-50 hover:bg-orange-50 border border-[#e2e4e8] text-[#111315] rounded-xl font-body-md text-[13px] font-semibold flex items-center justify-center gap-1 transition-colors">
                            <span class="material-symbols-outlined text-[16px] text-slate-500">description</span>
                            <span>Hồ sơ thiết bị</span>
                          </a>
